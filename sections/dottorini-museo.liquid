{% comment %}
  Museo della Civiltà Contadina: a photo showroom for the family's small
  collection of rural life exhibits. One anchor photo plus a grid of smaller
  ones, no captions, the images carry the section. A different layout family
  from the rest of the page (bento grid, not a split or a scroll gallery).
{% endcomment %}

<div class="section-band full-width {{ section.settings.background }}">
<div class="d-museo section-band__inner section-space section-space--flush-top" id="{{ section.settings.anchor | default: 'museo' | handleize }}">
  <div class="d-museo__head reveal">
    {% if section.settings.heading != blank %}
      <h1 class="d-museo__heading">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="d-museo__text">{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.link != blank and section.settings.link_label != blank %}
      <a
        class="button d-museo__cta"
        href="{{ section.settings.link }}"
        {% if section.settings.link contains '://' %}
          target="_blank" rel="noopener"
        {% endif %}
      >
        {{- section.settings.link_label -}}
      </a>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <ul class="d-museo__grid" role="list">
      {% for block in section.blocks %}
        {% assign sizes = '(min-width: 900px) 22vw, 90vw' %}
        {% if forloop.first %}
          {% assign sizes = '(min-width: 900px) 45vw, 90vw' %}
        {% endif %}
        <li class="d-museo__item reveal" {{ block.shopify_attributes }}>
          <div class="d-museo__photo">
            {% if block.settings.image %}
              {% assign image_position = 'object-position: ' | append: block.settings.image.presentation.focal_point %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  widths: '400, 600, 900, 1200',
                  sizes: sizes,
                  loading: 'lazy',
                  alt: block.settings.image.alt,
                  style: image_position
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'd-museo__placeholder' }}
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
</div>

{% stylesheet %}
  .d-museo__head {
    max-width: 46ch;
  }

  .d-museo__heading {
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    letter-spacing: -0.035em;
  }

  .d-museo__text {
    margin-top: 1rem;
    color: var(--color-muted);
  }

  .d-museo__cta {
    margin-top: 1.75rem;
  }

  /* One anchor photo, taller than the rest, then a stack of smaller ones.
     Single column on phones with a bit of rhythm per position. */
  .d-museo__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .d-museo__photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-media);
    background-color: var(--color-surface-strong);
    aspect-ratio: 4 / 5;
  }

  /* Rhythm on phones only: nth-child specificity would otherwise beat the
     desktop aspect-ratio: auto reset below and leave gaps in the grid. */
  @media (max-width: 899px) {
    .d-museo__item:nth-child(2) .d-museo__photo,
    .d-museo__item:nth-child(5) .d-museo__photo {
      aspect-ratio: 16 / 10;
    }

    .d-museo__item:nth-child(3) .d-museo__photo,
    .d-museo__item:nth-child(4) .d-museo__photo {
      aspect-ratio: 1 / 1;
    }
  }

  .d-museo__photo img,
  .d-museo__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d-museo__placeholder {
    fill: rgb(30 34 29 / 0.14);
  }

  /* From 900px: the first photo anchors a 2x2 block, the rest fill in around
     it as a bento grid. Works for any block count, not just five: dense
     packing fills gaps left to right with no holes. */
  @media (min-width: 900px) {
    .d-museo__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: clamp(9rem, 12vw, 12rem);
      grid-auto-flow: dense;
      gap: 1.25rem;
    }

    .d-museo__item:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }

    .d-museo__photo {
      height: 100%;
      aspect-ratio: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dottorini museo",
  "tag": "section",
  "class": "d-museo-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Il Museo della Civiltà Contadina"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "Under 25 words.",
      "default": "Attrezzi, gesti e storie di chi ha lavorato questa terra prima di noi, raccolti in una piccola collezione a Collazzone."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button label",
      "info": "Leave blank to hide the button."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link",
      "info": "External links open in a new tab."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "info": "The header's Museo link points here by default (#museo).",
      "default": "museo"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "d-bg--base",
      "options": [
        { "value": "d-bg--base", "label": "Default" },
        { "value": "d-bg--tint", "label": "Tinted" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Foto",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "The first photo anchors the grid and reads larger than the rest."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dottorini museo",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
