{% comment %}
  Editorial statement: one large sentence, then a short company text with a
  couple of highlighted facts (blocks) and the signature, beside a single
  offset portrait image.
{% endcomment %}

<div class="section-band full-width {{ section.settings.background }}">
<div class="d-manifesto section-band__inner section-space">
  <div class="d-manifesto__statement reveal">
    {{ section.settings.statement }}
  </div>

  <div class="d-manifesto__foot">
    <div class="d-manifesto__story reveal">
      {% if section.settings.body != blank %}
        <div class="d-manifesto__body">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <dl class="d-manifesto__facts">
          {% for block in section.blocks %}
            <div class="d-manifesto__fact" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.title }}</dt>
              {% if block.settings.detail != blank %}
                <dd>{{ block.settings.detail }}</dd>
              {% endif %}
            </div>
          {% endfor %}
        </dl>
      {% endif %}

      {% if section.settings.signature != blank %}
        <p class="d-manifesto__signature">{{ section.settings.signature }}</p>
      {% endif %}
    </div>

    <div class="d-manifesto__media reveal">
      {% if section.settings.image %}
        {% assign image_position = 'object-position: ' | append: section.settings.image.presentation.focal_point %}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            widths: '500, 800, 1100, 1400',
            sizes: '(min-width: 900px) 34vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image.alt,
            style: image_position
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'd-manifesto__placeholder' }}
      {% endif %}
    </div>
  </div>
</div>
</div>

{% stylesheet %}
  .d-manifesto__statement {
    max-width: 22ch;
    font-size: clamp(1.875rem, 4.6vw, 4rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .d-manifesto__statement p {
    margin: 0;
  }

  .d-manifesto__statement em {
    font-style: italic;
    color: var(--color-accent);
  }

  .d-manifesto__foot {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .d-manifesto__body {
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .d-manifesto__body p {
    margin: 0;
  }

  .d-manifesto__body p + p {
    margin-top: 1em;
  }

  /* The two promises, lifted off the band as small light tiles: the claim is
     the big line, the timing sits under it in olive */
  .d-manifesto__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
    max-width: 34rem;
    margin: 2rem 0 0;
  }

  .d-manifesto__fact {
    padding: 1.25rem 1.25rem 1.1rem;
    border-radius: var(--radius-media);
    background-color: var(--color-background);
  }

  .d-manifesto__fact dt {
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-foreground);
  }

  .d-manifesto__fact dd {
    margin: 0.45rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-accent);
  }

  .d-manifesto__signature {
    margin-top: 2rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .d-manifesto__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-media);
    background-color: var(--color-surface-strong);
  }

  .d-manifesto__media img,
  .d-manifesto__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d-manifesto__placeholder {
    fill: rgb(30 34 29 / 0.14);
  }

  /* Under 900px: text, facts and signature above a full-width image.
     From 900px the text sits beside the image, which rises into the
     statement above it. */
  @media (min-width: 900px) {
    .d-manifesto {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      column-gap: 1.25rem;
    }

    /* Stops before the image column: the image rises 8rem into this row,
       so a longer statement would otherwise run underneath it */
    .d-manifesto__statement {
      grid-column: 1 / span 7;
    }

    .d-manifesto__foot {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      align-items: start;
    }

    .d-manifesto__story {
      grid-column: 1 / span 6;
    }

    .d-manifesto__media {
      grid-column: 8 / span 4;
      margin-top: -8rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dottorini statement",
  "tag": "section",
  "class": "d-manifesto-section",
  "settings": [
    {
      "type": "richtext",
      "id": "statement",
      "label": "Statement",
      "info": "One or two sentences. Use italic to highlight a few words.",
      "default": "<p>Poche piante curate, una raccolta attenta, <em>nessuna scorciatoia</em>. Così nasce il nostro olio.</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "info": "Shown under the statement, beside the image."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "Famiglia Dottorini"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Portrait photo, 4:5. Hands, olives or a bottle detail."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "d-bg--tint",
      "options": [
        { "value": "d-bg--base", "label": "Default" },
        { "value": "d-bg--tint", "label": "Tinted" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "The big line, e.g. Raccolta a mano.",
          "default": "Raccolta a mano"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "info": "The small line underneath, in olive.",
          "default": "Ottobre-novembre"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Dottorini statement",
      "blocks": [
        { "type": "fact", "settings": { "title": "Raccolta a mano", "detail": "Ottobre-novembre" } },
        { "type": "fact", "settings": { "title": "Estratto a freddo", "detail": "Entro poche ore" } }
      ]
    }
  ]
}
{% endschema %}
