{% comment %}
  La collina: the photo on the left with a small dark note box overlapping
  its lower corner (a title and a line, both editable), and on the right the
  section name, the large statement, the company text and the signature.
  Phones stack the text above the photo, the note box still overlapping it.
{% endcomment %}

<div class="section-band full-width {{ section.settings.background }}">
<div class="d-manifesto section-band__inner section-space" id="{{ section.settings.anchor | default: 'collina' | handleize }}">
  <div class="d-manifesto__visual reveal">
    <div class="d-manifesto__media">
      {% if section.settings.image %}
        {% assign image_position = 'object-position: ' | append: section.settings.image.presentation.focal_point %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '500, 800, 1100, 1400, 1600',
            sizes: '(min-width: 900px) 50vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image.alt,
            style: image_position
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'd-manifesto__placeholder' }}
      {% endif %}
    </div>

    {% if section.settings.note_title != blank or section.settings.note_text != blank %}
      <div class="d-manifesto__note">
        {% if section.settings.note_title != blank %}
          <p class="d-manifesto__note-title">{{ section.settings.note_title }}</p>
        {% endif %}
        {% if section.settings.note_text != blank %}
          <p class="d-manifesto__note-text">{{ section.settings.note_text }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="d-manifesto__copy reveal">
    {% render 'section-label', label: section.settings.label %}

    <div class="d-manifesto__statement type-display">
      {{ section.settings.statement }}
    </div>

    {% if section.settings.body != blank %}
      <div class="d-manifesto__body">{{ section.settings.body }}</div>
    {% endif %}

    {% if section.settings.signature != blank %}
      <p class="d-manifesto__signature">{{ section.settings.signature }}</p>
    {% endif %}
  </div>
</div>
</div>

{% stylesheet %}
  /* Phones: text first, then the photo with the note box over its foot */
  .d-manifesto {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .d-manifesto__visual {
    order: 2;
    position: relative;
  }

  .d-manifesto__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-media);
    background-color: var(--color-surface-strong);
  }

  .d-manifesto__media img,
  .d-manifesto__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d-manifesto__placeholder {
    fill: rgb(33 28 20 / 0.14);
  }

  /* The note: a small dark box overlapping the photo's lower corner */
  .d-manifesto__note {
    position: relative;
    width: min(22rem, 86%);
    margin: -4.5rem 0 0 auto;
    padding: clamp(1.5rem, 2.6vw, 2.25rem) clamp(1.5rem, 3vw, 2.75rem);
    border-radius: var(--radius-media);
    background-color: var(--color-dark);
    color: var(--color-on-photo);
  }

  .d-manifesto__note-title {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.05;
    color: var(--color-logo);
  }

  .d-manifesto__note-text {
    margin-top: 0.75rem;
    line-height: 1.55;
    color: rgb(253 252 249 / 0.72);
  }

  .d-manifesto__statement {
    max-width: 22ch;
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 1.12;
  }

  .d-manifesto__statement p {
    margin: 0;
  }

  .d-manifesto__statement em {
    color: var(--color-accent);
  }

  .d-manifesto__body {
    max-width: 52ch;
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .d-manifesto__body p {
    margin: 0;
  }

  .d-manifesto__body p + p {
    margin-top: 1em;
  }

  .d-manifesto__signature {
    margin-top: 2rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  /* From 900px: photo left (the note box hangs past its right edge into
     the gutter), text right, both starting at the top */
  @media (min-width: 900px) {
    .d-manifesto {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.25rem;
      align-items: center;
      padding-bottom: calc(var(--section-space) + 2.5rem);
    }

    .d-manifesto__visual {
      order: 0;
      grid-column: 1 / span 6;
    }

    .d-manifesto__media {
      aspect-ratio: 1 / 1.05;
    }

    .d-manifesto__note {
      position: absolute;
      right: -2.75rem;
      bottom: -2.5rem;
      width: min(22rem, 68%);
      margin: 0;
    }

    .d-manifesto__copy {
      grid-column: 8 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dottorini statement",
  "tag": "section",
  "class": "d-manifesto-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section name",
      "info": "Small name at the top of the section, matching its menu link. Leave blank to hide it.",
      "default": "La collina"
    },
    {
      "type": "richtext",
      "id": "statement",
      "label": "Statement",
      "info": "One or two sentences. Use italic to highlight a few words.",
      "default": "<p>Poche piante curate, una raccolta attenta, <em>nessuna scorciatoia</em>. Così nasce il nostro olio.</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "info": "Shown under the statement."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "Famiglia Dottorini"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "The family or the olive trees. Shown 4:5 on phones, almost square from 900px."
    },
    {
      "type": "header",
      "content": "Note box over the photo"
    },
    {
      "type": "text",
      "id": "note_title",
      "label": "Title",
      "default": "La collina"
    },
    {
      "type": "textarea",
      "id": "note_text",
      "label": "Text",
      "info": "One short line. Leave both blank to hide the box.",
      "default": "Un solo crinale, lo stesso che disegna il nostro marchio."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "d-bg--tint",
      "options": [
        { "value": "d-bg--base", "label": "Default" },
        { "value": "d-bg--tint", "label": "Tinted" }
      ]
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "info": "The header's \"La collina\" link points here (/#collina).",
      "default": "collina"
    }
  ],
  "presets": [
    {
      "name": "Dottorini statement"
    }
  ]
}
{% endschema %}
