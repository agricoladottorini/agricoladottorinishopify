{% comment %}
  Editorial statement: one large sentence, a short signature and a single
  offset portrait image.
{% endcomment %}

<div class="section-band full-width {{ section.settings.background }}">
<div class="d-manifesto section-band__inner section-space">
  <div class="d-manifesto__statement reveal">
    {{ section.settings.statement }}
  </div>

  <div class="d-manifesto__foot">
    {% if section.settings.signature != blank %}
      <p class="d-manifesto__signature reveal">{{ section.settings.signature }}</p>
    {% endif %}

    <div class="d-manifesto__media reveal">
      {% if section.settings.image %}
        {% assign image_position = 'object-position: ' | append: section.settings.image.presentation.focal_point %}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            widths: '500, 800, 1100, 1400',
            sizes: '(min-width: 900px) 34vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image.alt,
            style: image_position
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'd-manifesto__placeholder' }}
      {% endif %}
    </div>
  </div>
</div>
</div>

{% stylesheet %}
  .d-manifesto__statement {
    max-width: 22ch;
    font-size: clamp(1.875rem, 4.6vw, 4rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .d-manifesto__statement p {
    margin: 0;
  }

  .d-manifesto__statement em {
    font-style: italic;
    color: var(--color-accent);
  }

  .d-manifesto__foot {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .d-manifesto__signature {
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .d-manifesto__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-media);
    background-color: var(--color-surface-strong);
  }

  .d-manifesto__media img,
  .d-manifesto__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d-manifesto__placeholder {
    fill: rgb(30 34 29 / 0.14);
  }

  /* Under 900px: signature above a full-width image */
  @media (min-width: 900px) {
    .d-manifesto {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      column-gap: 1.25rem;
    }

    .d-manifesto__statement {
      grid-column: 1 / span 10;
    }

    .d-manifesto__foot {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      align-items: end;
    }

    .d-manifesto__signature {
      grid-column: 1 / span 4;
    }

    .d-manifesto__media {
      grid-column: 8 / span 4;
      margin-top: -8rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dottorini statement",
  "tag": "section",
  "class": "d-manifesto-section",
  "settings": [
    {
      "type": "richtext",
      "id": "statement",
      "label": "Statement",
      "info": "One or two sentences. Use italic to highlight a few words.",
      "default": "<p>Poche piante curate, una raccolta attenta, <em>nessuna scorciatoia</em>. Così nasce il nostro olio.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "Famiglia Dottorini"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Portrait photo, 4:5. Hands, olives or a bottle detail."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "d-bg--tint",
      "options": [
        { "value": "d-bg--base", "label": "Default" },
        { "value": "d-bg--tint", "label": "Tinted" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dottorini statement"
    }
  ]
}
{% endschema %}
