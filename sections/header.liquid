{%- liquid
  assign wordmark = section.settings.wordmark | default: shop.name
  assign words = wordmark | strip | split: ' '
  assign tail = words | last
  assign lead = ''
  if words.size > 1
    assign lead_count = words.size | minus: 1
    assign lead_words = words | slice: 0, lead_count
    assign lead = lead_words | join: ' '
  endif
-%}

<site-header>
  <header class="site-header">
    <a class="site-header__brand" href="{{ routes.root_url }}">
      {% if section.settings.logo %}
        {% assign logo_style = '--logo-width: ' | append: section.settings.logo_width | append: 'px' %}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag: class: 'site-header__logo', alt: shop.name, style: logo_style
        }}
      {% else %}
        {%- if lead != blank -%}
          <span class="site-header__word site-header__word--lead">{{ lead }}</span>
        {%- endif -%}
        <span class="site-header__word site-header__word--tail">{{ tail }}</span>
      {% endif %}
    </a>

    {% comment %}
      Contact entries scroll to the footer, where the details already live.
      Remove the item from the menu in Shopify navigation to drop it entirely.
      The Convivia link is a theme setting, not a menu item: it points at the
      homepage anchor so it works from every page.
    {% endcomment %}
    <nav class="site-header__nav" aria-label="{{ section.settings.menu_label | escape }}">
      {% render 'header-nav-links',
        menu: section.settings.menu,
        extra_label: section.settings.extra_link_label,
        extra_href: section.settings.extra_link_href
      %}
    </nav>

    <div class="site-header__end">
      <details class="site-header__drawer">
        <summary class="site-header__drawer-toggle">
          <span class="site-header__burger" aria-hidden="true"></span>
          <span class="visually-hidden">{{ section.settings.menu_label }}</span>
        </summary>

        <nav class="site-header__drawer-panel" aria-label="{{ section.settings.menu_label | escape }}">
          {% render 'header-nav-links',
            menu: section.settings.menu,
            extra_label: section.settings.extra_link_label,
            extra_href: section.settings.extra_link_href,
            stagger: true
          %}
        </nav>
      </details>

      <div class="site-header__icons">
        {% comment %}
          Search button disabled for now. Uncomment to switch it back on: the
          modal below and its script are still in place and do nothing while
          this button is absent.

          <button type="button" class="site-header__search-toggle">
            {{ 'icon-search.svg' | inline_asset_content }}
            <span class="visually-hidden">{{ section.settings.search_label }}</span>
          </button>
        {% endcomment %}

        {% if shop.customer_accounts_enabled %}
          <shopify-account menu="{{ section.settings.customer_account_menu }}">
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {% endif %}

        <a class="site-header__cart" href="{{ routes.cart_url }}" data-cart-open>
          {{ 'icon-cart.svg' | inline_asset_content }}
          <span class="visually-hidden">{{ section.settings.cart_label }}</span>
          {% if cart.item_count > 0 %}
            <span class="site-header__cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>
    </div>
  </header>

  {% comment %} scroll-lock is picked up by the reset in critical.css {% endcomment %}
  <dialog class="site-search" scroll-lock aria-label="{{ section.settings.search_label | escape }}">
    <form class="site-search__form" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">

      <label class="visually-hidden" for="SiteSearchInput">{{ section.settings.search_label }}</label>
      <div class="site-search__field">
        <input
          id="SiteSearchInput"
          class="site-search__input"
          type="search"
          name="q"
          autocomplete="off"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          required
        >
        <button type="submit" class="button">{{ section.settings.search_label }}</button>
      </div>
    </form>

    <button type="button" class="site-search__close">
      <span class="site-search__close-mark" aria-hidden="true"></span>
      <span class="visually-hidden">{{ section.settings.search_close_label }}</span>
    </button>
  </dialog>
</site-header>

{% stylesheet %}
  .shopify-section-group-header-group {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: rgb(245 246 242 / 0.86);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    backdrop-filter: saturate(160%) blur(14px);
  }

  site-header {
    display: block;
  }

  /* Marker element just below the sticky header; when it leaves the
     viewport the header switches to its compact wordmark. */
  .site-header__sentinel {
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
  }

  /*
    Three fixed tracks. The middle one is flexible, so when the wordmark
    collapses that space is absorbed there and the icons on the right do not
    move at all.
  */
  .site-header {
    display: grid;
    grid-template-columns: auto minmax(1rem, 1fr) auto;
    align-items: center;
    height: var(--header-height);
  }

  .site-header a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  /* Brand, left */
  .site-header__brand {
    grid-column: 1;
    display: inline-flex;
    align-items: baseline;
    min-width: 0;
    white-space: nowrap;
    font-size: clamp(1rem, 4.4vw, 1.375rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .site-header__logo {
    width: var(--logo-width);
    height: auto;
  }

  /*
    The first word collapses its own width, so the last word slides left into
    its place. Reverses on scroll up because it is a plain transition.
    --lead-width is measured in JavaScript; the 12ch fallback keeps it working
    before that runs.
  */
  .site-header__word--lead {
    /* One knob for the whole collapse. The fade runs at 60% of it.
       The easing is deliberately even, not the front-loaded page easing,
       so the slide reads as unhurried the whole way through. */
    --brand-collapse: 1.1s;
    --brand-ease: cubic-bezier(0.65, 0, 0.35, 1);

    display: inline-block;
    overflow: hidden;
    max-width: var(--lead-width, 12ch);
    margin-right: 0.3em;
    opacity: 1;
    transition: max-width var(--brand-collapse) var(--brand-ease),
      margin-right var(--brand-collapse) var(--brand-ease),
      transform var(--brand-collapse) var(--brand-ease),
      opacity calc(var(--brand-collapse) * 0.6) var(--brand-ease);
  }

  site-header.is-compact .site-header__word--lead {
    max-width: 0;
    margin-right: 0;
    opacity: 0;
    transform: translateX(-0.25em);
  }

  /* Nav, desktop only */
  .site-header__nav {
    grid-column: 2;
    display: none;
    justify-self: end;
    gap: 2rem;
    margin-right: 2rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .site-header__nav a {
    position: relative;
  }

  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3rem;
    height: 1px;
    background-color: currentcolor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .site-header__nav a:hover::after,
  .site-header__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* Right cluster: pinned to the right edge, never moves */
  .site-header__end {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header__icons {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header__icons svg {
    width: 1.5rem;
  }

  .site-header__cart {
    position: relative;
    display: flex;
  }

  .site-header__cart-count {
    position: absolute;
    top: -0.35rem;
    right: -0.55rem;
    display: grid;
    place-items: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.25rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    color: var(--color-background);
    font-size: 0.6875rem;
    line-height: 1;
  }

  .site-header__search-toggle {
    display: flex;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-foreground);
    cursor: pointer;
  }

  /* Search modal */
  .site-search {
    width: min(42rem, calc(100vw - 2 * var(--page-margin)));
    margin: min(16vh, 7rem) auto auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 0;
    border-radius: var(--radius-media);
    background-color: var(--color-background);
    color: var(--color-foreground);
    box-shadow: 0 1.5rem 4rem rgb(30 34 29 / 0.18);
  }

  .site-search::backdrop {
    background-color: rgb(20 24 18 / 0.45);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }

  .site-search__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-search__field .button {
    justify-content: center;
  }

  /* Side by side once there is room for both */
  @media (min-width: 560px) {
    .site-search__field {
      flex-direction: row;
    }
  }

  .site-search__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 1px solid #8a8f84;
    border-radius: var(--radius-pill);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-size: 1.0625rem;
  }

  .site-search__input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .site-search__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--color-muted);
    cursor: pointer;
  }

  .site-search__close:hover {
    color: var(--color-foreground);
  }

  .site-search__close-mark,
  .site-search__close-mark::before {
    display: block;
    width: 0.9rem;
    height: 2px;
    border-radius: 2px;
    background-color: currentcolor;
  }

  .site-search__close-mark {
    transform: rotate(45deg);
  }

  .site-search__close-mark::before {
    content: '';
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-search[open] {
      animation: search-in 0.28s var(--ease-out) both;
    }

    .site-search[open]::backdrop {
      animation: search-fade 0.28s var(--ease-out) both;
    }
  }

  @keyframes search-in {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes search-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header__cart-count.is-bumped {
      animation: cart-bump 0.45s var(--ease-out);
    }
  }

  @keyframes cart-bump {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.35);
    }
    100% {
      transform: scale(1);
    }
  }

  /* Mobile menu: native <details>, so it still works without JavaScript */
  .site-header__drawer-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    list-style: none;
    cursor: pointer;
  }

  .site-header__drawer-toggle::-webkit-details-marker {
    display: none;
  }

  /* Hamburger: three bars built from one element, crossing into an X */
  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 1.3125rem;
    height: 2px;
    border-radius: 2px;
    background-color: currentcolor;
    transition: transform 0.35s var(--ease-out), opacity 0.2s var(--ease-out);
  }

  .site-header__burger {
    position: relative;
  }

  .site-header__burger::before,
  .site-header__burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__burger::before {
    top: -0.375rem;
  }

  .site-header__burger::after {
    top: 0.375rem;
  }

  .site-header__drawer[open] .site-header__burger {
    background-color: transparent;
  }

  .site-header__drawer[open] .site-header__burger::before {
    transform: translateY(0.375rem) rotate(45deg);
  }

  .site-header__drawer[open] .site-header__burger::after {
    transform: translateY(-0.375rem) rotate(-45deg);
  }

  .site-header__drawer-panel {
    position: absolute;
    z-index: 20;
    top: var(--header-height);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem var(--page-margin) 2.5rem;
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-surface-strong);
    font-size: 1.75rem;
    letter-spacing: -0.02em;
    transform-origin: top center;
    transition: opacity 0.26s var(--ease-out), transform 0.3s var(--ease-out);
  }

  /* Opening: panel drops down, links follow one after another */
  .site-header__drawer[open] .site-header__drawer-panel {
    animation: drawer-drop 0.34s var(--ease-out) both;
  }

  .site-header__drawer[open] .site-header__drawer-panel a {
    animation: drawer-item 0.42s var(--ease-out) both;
    animation-delay: calc(0.1s + var(--i, 0) * 0.06s);
  }

  /* Closing: JavaScript keeps the panel open long enough to transition out */
  .site-header__drawer.is-closing .site-header__drawer-panel {
    animation: none;
    opacity: 0;
    transform: translateY(-0.75rem);
  }

  .site-header__drawer.is-closing .site-header__drawer-panel a {
    animation: none;
  }

  @keyframes drawer-drop {
    from {
      opacity: 0;
      transform: translateY(-0.85rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes drawer-item {
    from {
      opacity: 0;
      transform: translateY(-0.6rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 900px) {
    .site-header__nav {
      display: flex;
    }

    .site-header__drawer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__word--lead,
    .site-header__burger,
    .site-header__burger::before,
    .site-header__burger::after,
    .site-header__drawer-panel {
      transition: none;
    }

    .site-header__drawer[open] .site-header__drawer-panel,
    .site-header__drawer[open] .site-header__drawer-panel a {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class SiteHeader extends HTMLElement {
    connectedCallback() {
      this.brand = this.querySelector('.site-header__brand');
      this.lead = this.querySelector('.site-header__word--lead');

      if (this.lead && this.brand) {
        this.measure = () => {
          const width = this.lead.scrollWidth;
          if (width && Math.abs(width - (this.measured || 0)) > 0.5) {
            this.measured = width;
            this.brand.style.setProperty('--lead-width', `${width}px`);
          }
        };
        this.measure();
        document.fonts?.ready.then(() => this.measure());
        this.resizeObserver = new ResizeObserver(() => this.measure());
        this.resizeObserver.observe(this);
      }

      this.setUpDrawer();
      this.setUpSearch();
      this.settleHashTarget();

      // The sentinel has to sit outside the sticky wrapper, in normal flow.
      const sticky = this.closest('.shopify-section-group-header-group') || this.closest('.shopify-section');
      if (!sticky) return;
      this.sentinel = document.createElement('div');
      this.sentinel.className = 'site-header__sentinel';
      this.sentinel.setAttribute('aria-hidden', 'true');
      sticky.insertAdjacentElement('afterend', this.sentinel);

      this.observer = new IntersectionObserver(([entry]) => {
        this.classList.toggle('is-compact', !entry.isIntersecting);
      });
      this.observer.observe(this.sentinel);
    }

    // <details> animates open on its own; closing needs the panel to stay
    // in the DOM until its transition has finished.
    setUpDrawer() {
      const details = this.querySelector('.site-header__drawer');
      const summary = this.querySelector('.site-header__drawer-toggle');
      const panel = this.querySelector('.site-header__drawer-panel');
      if (!details || !summary || !panel) return;

      this.closeDrawer = (event) => {
        if (!details.open || this.closing) return;
        event.preventDefault();
        this.closing = true;
        details.classList.add('is-closing');

        const finish = () => {
          clearTimeout(timer);
          panel.removeEventListener('transitionend', finish);
          details.open = false;
          details.classList.remove('is-closing');
          this.closing = false;
        };
        const timer = setTimeout(finish, 420);
        panel.addEventListener('transitionend', finish);
      };

      summary.addEventListener('click', this.closeDrawer);

      // Anchor links (#contatti, /#convivia) stay on the page, so close the
      // drawer or it would keep covering the section it just scrolled to.
      this.closeOnLink = (event) => {
        if (event.target.closest('a')) details.open = false;
      };
      panel.addEventListener('click', this.closeOnLink);
      this.drawer = { details, summary, panel };
    }

    // Arriving from another page on /#convivia or /#contatti: the browser's
    // own jump can land short or be cancelled while images and fonts still
    // shift the layout, so settle on the target once the page has loaded.
    settleHashTarget() {
      if (!location.hash) return;
      const settle = () => {
        let target;
        try {
          target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        } catch (error) {
          return;
        }
        if (!target) return;
        const top = target.getBoundingClientRect().top;
        const header = this.getBoundingClientRect().height;
        if (Math.abs(top - header) > 40) target.scrollIntoView({ behavior: 'instant', block: 'start' });
      };
      if (document.readyState === 'complete') settle();
      else window.addEventListener('load', settle, { once: true });
    }

    setUpSearch() {
      const dialog = this.querySelector('.site-search');
      const toggle = this.querySelector('.site-header__search-toggle');
      const close = this.querySelector('.site-search__close');
      const input = this.querySelector('.site-search__input');
      if (!dialog || !toggle) return;

      this.openSearch = () => {
        dialog.showModal();
        input?.focus();
      };
      // Clicking the backdrop lands on the dialog itself, never on its content
      this.backdropClose = (event) => {
        if (event.target === dialog) dialog.close();
      };
      this.closeSearch = () => dialog.close();

      toggle.addEventListener('click', this.openSearch);
      dialog.addEventListener('click', this.backdropClose);
      close?.addEventListener('click', this.closeSearch);
      this.search = { dialog, toggle, close };
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.resizeObserver?.disconnect();
      this.sentinel?.remove();
      if (this.drawer && this.closeDrawer) {
        this.drawer.summary.removeEventListener('click', this.closeDrawer);
        this.drawer.panel.removeEventListener('click', this.closeOnLink);
      }
      if (this.search) {
        this.search.toggle.removeEventListener('click', this.openSearch);
        this.search.dialog.removeEventListener('click', this.backdropClose);
        this.search.close?.removeEventListener('click', this.closeSearch);
      }
    }
  }

  if (!customElements.get('site-header')) customElements.define('site-header', SiteHeader);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark (used when no logo)",
      "info": "With two or more words, the last one stays on screen and the rest collapse away on scroll.",
      "default": "Agricola Dottorini"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "text",
      "id": "extra_link_label",
      "label": "Extra menu link",
      "info": "Shown just before the contact entry. Leave blank to hide it.",
      "default": "Convivia"
    },
    {
      "type": "text",
      "id": "extra_link_href",
      "label": "Extra menu link target",
      "info": "Use /#anchor for a homepage section, so it works from every page.",
      "default": "/#convivia"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Menu (for screen readers)",
      "default": "Menu"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart",
      "default": "Carrello"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search",
      "default": "Cerca"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Cerca un prodotto"
    },
    {
      "type": "text",
      "id": "search_close_label",
      "label": "Close search",
      "default": "Chiudi la ricerca"
    }
  ]
}
{% endschema %}
