{%- liquid
  assign wordmark = section.settings.wordmark | default: shop.name
  assign words = wordmark | strip | split: ' '
  assign tail = words | last
  assign lead = ''
  if words.size > 1
    assign lead_count = words.size | minus: 1
    assign lead_words = words | slice: 0, lead_count
    assign lead = lead_words | join: ' '
  endif
-%}

<site-header>
  <header class="site-header">
    <a class="site-header__brand" href="{{ routes.root_url }}">
      {% if section.settings.logo %}
        {% assign logo_style = '--logo-width: ' | append: section.settings.logo_width | append: 'px' %}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag: class: 'site-header__logo', alt: shop.name, style: logo_style
        }}
      {% else %}
        {%- if lead != blank -%}
          <span class="site-header__word site-header__word--lead">{{ lead }}</span>
        {%- endif -%}
        <span class="site-header__word site-header__word--tail">{{ tail }}</span>
      {% endif %}
    </a>

    <nav class="site-header__nav" aria-label="{{ section.settings.menu_label | escape }}">
      {% for link in section.settings.menu.links %}
        <a
          href="{{ link.url }}"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          {{- link.title -}}
        </a>
      {% endfor %}
    </nav>

    <div class="site-header__end">
      <details class="site-header__drawer">
        <summary class="site-header__drawer-toggle">
          <span class="site-header__drawer-open">{{ section.settings.menu_label }}</span>
          <span class="site-header__drawer-close">{{ section.settings.close_label }}</span>
        </summary>

        <nav class="site-header__drawer-panel" aria-label="{{ section.settings.menu_label | escape }}">
          {% for link in section.settings.menu.links %}
            <a
              href="{{ link.url }}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title -}}
            </a>
          {% endfor %}
        </nav>
      </details>

      <div class="site-header__icons">
        {% if shop.customer_accounts_enabled %}
          <shopify-account menu="{{ section.settings.customer_account_menu }}">
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {% endif %}

        <a class="site-header__cart" href="{{ routes.cart_url }}">
          {{ 'icon-cart.svg' | inline_asset_content }}
          <span class="visually-hidden">{{ section.settings.cart_label }}</span>
          {% if cart.item_count > 0 %}
            <span class="site-header__cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>
    </div>
  </header>
</site-header>

{% stylesheet %}
  .shopify-section-group-header-group {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: rgb(245 246 242 / 0.86);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    backdrop-filter: saturate(160%) blur(14px);
  }

  site-header {
    display: block;
  }

  /* Marker element just below the sticky header; when it leaves the
     viewport the header switches to its compact wordmark. */
  .site-header__sentinel {
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
  }

  .site-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 1rem;
    height: var(--header-height);
  }

  .site-header a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  /* Brand, left */
  .site-header__brand {
    display: inline-flex;
    align-items: baseline;
    min-width: 0;
    white-space: nowrap;
    /* Scales down so the full two-word name fits next to the menu on phones */
    font-size: clamp(1rem, 4.4vw, 1.375rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .site-header__logo {
    width: var(--logo-width);
    height: auto;
  }

  /*
    The first word collapses its own width, so the last word slides left into
    its place. Reverses on scroll up because it is a plain transition.
    --lead-width is measured in JavaScript; the 12ch fallback keeps it working
    before that runs.
  */
  .site-header__word--lead {
    /* One knob for the whole collapse. The fade runs at half of it.
       The easing is deliberately even, not the front-loaded page easing,
       so the slide reads as unhurried the whole way through. */
    --brand-collapse: 1.1s;
    --brand-ease: cubic-bezier(0.65, 0, 0.35, 1);

    display: inline-block;
    overflow: hidden;
    max-width: var(--lead-width, 12ch);
    margin-right: 0.3em;
    opacity: 1;
    transition: max-width var(--brand-collapse) var(--brand-ease),
      margin-right var(--brand-collapse) var(--brand-ease),
      transform var(--brand-collapse) var(--brand-ease),
      opacity calc(var(--brand-collapse) * 0.6) var(--brand-ease);
  }

  site-header.is-compact .site-header__word--lead {
    max-width: 0;
    margin-right: 0;
    opacity: 0;
    transform: translateX(-0.25em);
  }

  /* Nav, right of the brand and left of the icons */
  .site-header__nav {
    display: none;
    justify-self: end;
    gap: 2rem;
    margin-right: 2rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .site-header__nav a {
    position: relative;
  }

  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3rem;
    height: 1px;
    background-color: currentcolor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .site-header__nav a:hover::after,
  .site-header__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  @media (min-width: 900px) {
    .site-header__end {
      gap: 1.25rem;
    }
  }

  .site-header__icons {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-header__icons svg {
    width: 1.5rem;
  }

  .site-header__cart {
    position: relative;
    display: flex;
  }

  .site-header__cart-count {
    position: absolute;
    top: -0.35rem;
    right: -0.55rem;
    display: grid;
    place-items: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.25rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    color: var(--color-background);
    font-size: 0.6875rem;
    line-height: 1;
  }

  /* Mobile menu: native <details>, no JavaScript */
  .site-header__drawer-toggle {
    list-style: none;
    cursor: pointer;
    font-size: 0.9375rem;
  }

  .site-header__drawer-toggle::-webkit-details-marker {
    display: none;
  }

  .site-header__drawer-close,
  .site-header__drawer[open] .site-header__drawer-open {
    display: none;
  }

  .site-header__drawer[open] .site-header__drawer-close {
    display: inline;
  }

  .site-header__drawer-panel {
    position: absolute;
    z-index: 20;
    top: var(--header-height);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem var(--page-margin) 2.5rem;
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-surface-strong);
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }

  @media (min-width: 900px) {
    .site-header__nav {
      display: flex;
    }

    .site-header__drawer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__word--lead {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class SiteHeader extends HTMLElement {
    connectedCallback() {
      this.brand = this.querySelector('.site-header__brand');
      this.lead = this.querySelector('.site-header__word--lead');

      if (this.lead && this.brand) {
        this.measure = () => {
          const width = this.lead.scrollWidth;
          if (width && Math.abs(width - (this.measured || 0)) > 0.5) {
            this.measured = width;
            this.brand.style.setProperty('--lead-width', `${width}px`);
          }
        };
        this.measure();
        document.fonts?.ready.then(() => this.measure());
        this.resizeObserver = new ResizeObserver(() => this.measure());
        this.resizeObserver.observe(this);
      }

      // The sentinel has to sit outside the sticky wrapper, in normal flow.
      const sticky = this.closest('.shopify-section-group-header-group') || this.closest('.shopify-section');
      if (!sticky) return;
      this.sentinel = document.createElement('div');
      this.sentinel.className = 'site-header__sentinel';
      this.sentinel.setAttribute('aria-hidden', 'true');
      sticky.insertAdjacentElement('afterend', this.sentinel);

      this.observer = new IntersectionObserver(([entry]) => {
        this.classList.toggle('is-compact', !entry.isIntersecting);
      });
      this.observer.observe(this.sentinel);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.resizeObserver?.disconnect();
      this.sentinel?.remove();
    }
  }

  if (!customElements.get('site-header')) customElements.define('site-header', SiteHeader);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark (used when no logo)",
      "info": "With two or more words, the last one stays on screen and the rest collapse away on scroll.",
      "default": "Agricola Dottorini"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Menu",
      "default": "Menu"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Close",
      "default": "Chiudi"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart",
      "default": "Carrello"
    }
  ]
}
{% endschema %}
