{% comment %}
  Full-bleed framed media hero. The heading sits top left, the logo ribbon
  runs across the middle and the text and buttons sit at the bottom, each
  over a soft scrim so they stay readable on any photograph.
{% endcomment %}

<div class="d-hero full-width">
  <div class="d-hero__frame">
    <div class="d-hero__media">
      {% if section.settings.image %}
        {% assign image_position = 'object-position: ' | append: section.settings.image.presentation.focal_point %}
        {{
          section.settings.image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2600, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            preload: true,
            alt: section.settings.image.alt,
            style: image_position
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'd-hero__placeholder' }}
      {% endif %}
    </div>

    <div class="d-hero__content">
      {% if section.settings.heading != blank %}
        <h1 class="d-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.show_line %}
        {% comment %}
          The logo ribbon, between the heading and the text, full bleed across
          the frame: one filled path, the same one as snippets/brand-logo.liquid.
          Its ends are cut flat in the client's file, so they sit on the frame
          edges, which clip them. It is in the flow, so it can never overlap
          the copy: on a short screen the frame grows instead.
        {% endcomment %}
        <svg
          class="d-hero__line"
          viewBox="0 0 2481 754"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
          style="--line-color: {{ section.settings.line_color }};"
        >
          <path d="M0.1 687.9L-0 623.3L13.7 609.9C35.5 588.7 58.4 572.7 102.5 548C141.3 526.3 220.3 488.4 264.7 470.4C324 446.2 407.8 426.5 506 413.5C526.5 410.8 540 407.7 559.1 401.2C595.4 388.8 648.7 364.9 744.5 318C867.9 257.6 894.8 245 950.9 222C984.1 208.5 997.8 201.2 1027.5 181.5C1044.2 170.4 1055.5 162.1 1104.7 124.6C1159.1 83 1190.5 65 1228.5 53.4C1252.1 46.2 1309.5 33.7 1340 29.1C1409.8 18.7 1469 22.1 1523.5 39.7C1531.2 42.2 1560.3 53.5 1570.5 58C1573.2 59.2 1594.2 67.8 1617 77C1667.1 97.2 1684 104.6 1707 116.3C1755.3 140.8 1790.4 162.2 1869.3 215.1C1905.8 239.6 1915.7 245.6 1935.5 255.1C1971.3 272.1 2000.4 275.9 2032 267.4C2057 260.8 2078.1 248.8 2134.8 209.2C2165.6 187.8 2179.5 178.6 2197.9 167.8C2223.3 152.8 2234.4 147.9 2273 134.8C2314.9 120.6 2337.7 110.5 2361.8 95.6C2378.7 85.1 2392.3 74.4 2431.1 40.9C2442.3 31.3 2458.1 18.1 2466.2 11.7L2481 -0L2481 31.2L2481 62.5L2476.2 66.6C2452.5 86.8 2425.1 103.5 2342.5 148C2309.7 165.7 2290.5 176.6 2283.5 181.8C2281.3 183.4 2274.8 188.9 2269 194.1C2219 239.2 2147.4 287.3 2073 325.8C2031.9 347.1 2008.1 350.5 1969 340.9C1954.4 337.3 1948.8 335.3 1908 319.2C1864.1 301.9 1849.6 297.8 1820 294C1797.1 291.1 1788.3 289 1769.5 281.7C1747.8 273.4 1724.6 261.1 1677.5 233C1616.4 196.5 1595.9 185.8 1565 174.2C1536 163.3 1522.9 161.2 1476.5 160C1456.7 159.5 1424.1 158.1 1404 157C1342.8 153.6 1321.8 152.9 1289.5 152.8C1247.3 152.8 1223.8 155 1200.1 161.1C1184 165.3 1174.6 170 1157 183C1096.6 227.6 1019.6 268.7 922.1 308.5C900.2 317.4 849.8 336.8 814 350.2C755.3 372 735.4 380.4 697 399.6C651.2 422.5 629.1 432 584.5 448C505.9 476.1 391.6 505 334.5 511C315.1 513.1 304.1 516 282.2 525.1C208.1 555.8 103 627.9 44.3 688.4C21 712.3 9.4 728.4 2.8 745.5L0.1 752.5L0.1 687.9Z"/>
        </svg>
      {% endif %}

      <div class="d-hero__row">
        {% if section.settings.text != blank %}
          <p class="d-hero__text">{{ section.settings.text }}</p>
        {% endif %}

        <div class="d-hero__actions">
          {% if section.settings.primary_label != blank %}
            <a class="button button--light" href="{{ section.settings.primary_link | default: '#oli' }}">
              {{- section.settings.primary_label -}}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .d-hero {
    padding: 0.5rem var(--page-margin) 0;
  }

  .d-hero__frame {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: clamp(34rem, calc(100dvh - var(--header-height) - 0.5rem), 62rem);
    max-width: calc(var(--page-width) + 8rem);
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-media);
    background-color: #2b251b;
    color: var(--color-on-photo);
  }

  .d-hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .d-hero__media img,
  .d-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d-hero__placeholder {
    fill: rgb(251 246 236 / 0.14);
  }

  /* Scrims, top and bottom: AA contrast for the copy on light photographs
     (the heading usually lands on sky, the brightest part of the photo) */
  .d-hero__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgb(22 18 12 / 0.55) 0%, rgb(22 18 12 / 0.2) 26%, rgb(22 18 12 / 0) 42%),
      linear-gradient(to top, rgb(22 18 12 / 0.72) 0%, rgb(22 18 12 / 0.28) 30%, rgb(22 18 12 / 0) 50%);
    pointer-events: none;
  }

  /* Heading pinned to the top, text and buttons to the bottom */
  .d-hero__content {
    --hero-pad: clamp(1.5rem, 4vw, 3.5rem);
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    padding: var(--hero-pad);
  }

  /*
    Centred in the space between heading and text, and pulled out past the
    content padding so it runs edge to edge. The box keeps the ratio of the
    viewBox, so the whole ribbon scales with the frame. On short, wide
    screens it is capped in height and flattens a little, so the buttons
    stay above the fold.
  */
  .d-hero__line {
    display: block;
    flex: 0 0 auto;
    width: calc(100% + 2 * var(--hero-pad));
    max-width: none;
    height: auto;
    aspect-ratio: 2481 / 754;
    max-height: 40svh;
    margin: auto calc(-1 * var(--hero-pad));
    pointer-events: none;
  }

  .d-hero__line path {
    fill: var(--line-color);
  }

  /*
    Under 900px the scaled ribbon gets shallow and thin, so it is drawn 1.5x
    taller (the viewBox is not kept, preserveAspectRatio is none): the curve
    keeps its height and the band keeps its body.
  */
  @media (max-width: 899px) {
    .d-hero__line {
      aspect-ratio: 2481 / 1131;
    }
  }

  /* Draw-in: a soft-edged mask sweeps left to right, once */
  @media (prefers-reduced-motion: no-preference) {
    .d-hero__line {
      -webkit-mask-image: linear-gradient(90deg, #000 45%, transparent 55%);
      mask-image: linear-gradient(90deg, #000 45%, transparent 55%);
      -webkit-mask-size: 250% 100%;
      mask-size: 250% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      animation: d-hero-line-draw 2.4s var(--ease-out) 0.35s both;
    }
  }

  @keyframes d-hero-line-draw {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
  }

  .d-hero__heading {
    max-width: 13ch;
    padding-bottom: 0.08em;
    font-size: clamp(2.4rem, 8vw, 6.75rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .d-hero__row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .d-hero__text {
    max-width: 34ch;
    font-size: clamp(1rem, 1.3vw, 1.1875rem);
    line-height: 1.45;
    color: rgb(253 252 249 / 0.9);
  }

  .d-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Under 900px: the button runs full width and the frame stops short of the fold */
  @media (max-width: 899px) {
    .d-hero__frame {
      min-height: clamp(32rem, calc(100svh - var(--header-height) - 1.5rem), 50rem);
    }

    .d-hero__content {
      --hero-pad: 1.25rem;
    }

    .d-hero__actions .button {
      flex: 1 1 auto;
      min-height: 2.75rem;
      padding: 0 1rem;
      font-size: 0.875rem;
    }
  }

  @media (min-width: 900px) {
    .d-hero__actions {
      gap: 0.75rem;
    }

    .d-hero__row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .d-hero__media {
      animation: d-hero-settle 1.6s var(--ease-out) both;
    }

    .d-hero__heading,
    .d-hero__text,
    .d-hero__actions {
      animation: d-hero-rise 1s var(--ease-out) both;
    }

    .d-hero__text {
      animation-delay: 0.12s;
    }

    .d-hero__actions {
      animation-delay: 0.22s;
    }
  }

  @keyframes d-hero-settle {
    from {
      transform: scale(1.06);
    }
    to {
      transform: none;
    }
  }

  @keyframes d-hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dottorini hero",
  "tag": "section",
  "class": "d-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Landscape photo, at least 2400px wide. Product or harvest detail works best."
    },
    {
      "type": "checkbox",
      "id": "show_line",
      "label": "Show logo ribbon",
      "default": true
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Ribbon color",
      "default": "#B6B351",
      "visible_if": "{{ section.settings.show_line }}"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Olio extravergine, <em>nato in Umbria</em>."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "Keep it under 20 words.",
      "default": "Un solo ingrediente: le olive delle nostre colline. Nient'altro in bottiglia."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Button label",
      "default": "Scopri gli oli"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Button link",
      "info": "Leave empty to scroll to the products section."
    }
  ],
  "presets": [
    {
      "name": "Dottorini hero"
    }
  ]
}
{% endschema %}
