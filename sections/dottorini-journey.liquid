{% comment %}
  The olive varieties, as text-only cards (no photos, by the owner's
  request). Each card has a tone, dark, olive or light, which by default
  follows the oils from the most intense to the most delicate. Phones:
  horizontal scroll-snap gallery. From 900px, up to three cards sit in one
  row with the middle one dropped; more than three keep the gallery and its
  arrow buttons (a progressive enhancement).
{% endcomment %}

{%- liquid
  assign as_row = false
  if section.blocks.size <= 3
    assign as_row = true
  endif
-%}

<div class="section-band full-width {{ section.settings.background }}">
<scroll-gallery
  class="d-journey section-space{% if as_row %} d-journey--row{% endif %}"
  id="{{ section.settings.anchor | default: 'terra' | handleize }}"
>
  <div class="d-journey__head">
    <div>
      {% render 'section-label', label: section.settings.label %}
      {% if section.settings.heading != blank %}
        <h2 class="d-journey__heading reveal">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="d-journey__controls">
        <button type="button" class="d-journey__arrow" data-gallery-arrow data-direction="-1" aria-label="Precedente" disabled>
          <span aria-hidden="true">&larr;</span>
        </button>
        <button type="button" class="d-journey__arrow" data-gallery-arrow data-direction="1" aria-label="Successivo">
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>
    {% endif %}
  </div>

  <ol class="d-journey__track" data-gallery-track role="list" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
    {% for block in section.blocks %}
      <li class="d-journey__step" {{ block.shopify_attributes }}>
        <article class="d-variety {{ block.settings.tone }}">
          <h3 class="d-variety__title">{{ block.settings.title }}</h3>
          {% if block.settings.tagline != blank %}
            <p class="d-variety__tagline">{{ block.settings.tagline }}</p>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="d-variety__text">{{ block.settings.text }}</p>
          {% endif %}
        </article>
      </li>
    {% endfor %}
  </ol>
</scroll-gallery>
</div>

{% stylesheet %}
  .d-journey {
    --gutter: max(var(--page-margin), calc((100vw - var(--page-width)) / 2 + var(--page-margin)));
    display: block;
    overflow: hidden;
  }

  .d-journey__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-inline: var(--gutter);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .d-journey__heading {
    max-width: 20ch;
    font-size: clamp(2rem, 4.2vw, 3.5rem);
  }

  .d-journey__controls {
    display: none;
    gap: 0.5rem;
  }

  .d-journey__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid var(--color-foreground);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-size: 1.125rem;
    cursor: pointer;
    transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out), transform 0.2s var(--ease-out),
      opacity 0.3s var(--ease-out);
  }

  .d-journey__arrow:hover:not([disabled]) {
    background-color: var(--color-accent-light);
    border-color: var(--color-accent-light);
  }

  .d-journey__arrow:active:not([disabled]) {
    transform: scale(0.96);
  }

  .d-journey__arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .d-journey__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78vw;
    gap: 1rem;
    margin: 0;
    padding: 0 var(--gutter) 0.5rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .d-journey__track::-webkit-scrollbar {
    display: none;
  }

  .d-journey__step {
    scroll-snap-align: start;
  }

  /* Text card: name on top, the italic line under it, the text at the foot */
  .d-variety {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: clamp(19rem, 30vw, 25rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--radius-media);
    background-color: var(--variety-bg);
    color: var(--variety-fg);
  }

  .d-variety--dark {
    --variety-bg: var(--color-dark);
    --variety-fg: var(--color-on-photo);
    --variety-accent: var(--color-logo);
    --variety-muted: rgb(253 252 249 / 0.78);
  }

  .d-variety--olive {
    --variety-bg: var(--color-accent-base);
    --variety-fg: var(--color-on-photo);
    --variety-accent: #e4e1b0;
    --variety-muted: rgb(253 252 249 / 0.86);
  }

  .d-variety--light {
    --variety-bg: var(--color-tint);
    --variety-fg: var(--color-foreground);
    --variety-accent: var(--color-accent);
    --variety-muted: var(--color-muted);
  }

  .d-variety__title {
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.05;
    color: inherit;
  }

  .d-variety__tagline {
    max-width: 22ch;
    margin-top: 0.75rem;
    font-family: var(--font-accent--family);
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.25;
    color: var(--variety-accent);
  }

  .d-variety__text {
    max-width: 34ch;
    margin-top: auto;
    padding-top: 2rem;
    line-height: 1.6;
    color: var(--variety-muted);
  }

  /* From 900px: arrows appear and every second card drops for rhythm */
  @media (min-width: 900px) {
    .d-journey__controls {
      display: flex;
    }

    .d-journey__track {
      grid-auto-columns: clamp(18rem, 29vw, 27rem);
      gap: 1.5rem;
      padding-bottom: 4rem;
    }

    .d-journey__step:nth-child(even) {
      margin-top: 4rem;
    }

    /* Three cards or fewer: one row, no scrolling, no arrows */
    .d-journey--row .d-journey__controls {
      display: none;
    }

    .d-journey--row .d-journey__track {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      padding-inline: var(--gutter);
      overflow: visible;
    }
  }
{% endstylesheet %}

{% render 'scroll-gallery' %}


{% schema %}
{
  "name": "Dottorini varietà",
  "tag": "section",
  "class": "d-journey-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section name",
      "info": "Small name at the top of the section, matching its menu link. Leave blank to hide it.",
      "default": "Cultivar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tre olive, un solo blend d'equilibrio."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "info": "The header's \"Cultivar\" link points here (/#terra).",
      "default": "terra"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "d-bg--base",
      "options": [
        { "value": "d-bg--base", "label": "Default" },
        { "value": "d-bg--tint", "label": "Tinted" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Varietà",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Titolo"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "info": "A few words, shown in italic under the title."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "info": "Under 25 words."
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Card color",
          "default": "d-variety--light",
          "options": [
            { "value": "d-variety--dark", "label": "Dark" },
            { "value": "d-variety--olive", "label": "Olive" },
            { "value": "d-variety--light", "label": "Light" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dottorini varietà",
      "blocks": [
        {
          "type": "step",
          "settings": {"tone": "d-variety--dark", "title": "Moraiolo", "tagline": "Il carattere umbro per eccellenza.", "text": "Fruttato intenso, note d'erba, amaro e piccante decisi. Dà spina dorsale al blend."}
        },
        {
          "type": "step",
          "settings": {"tone": "d-variety--olive", "title": "Frantoiano", "tagline": "Eleganza ed armonia.", "text": "Fruttato medio, profumi floreali e di mandorla. Smussa e arrotonda, porta finezza al taglio."}
        },
        {
          "type": "step",
          "settings": {"tone": "d-variety--light", "title": "Leccino", "tagline": "Morbidezza e gentilezza.", "text": "Fruttato delicato, sentori dolci e puliti. Bilancia l'insieme e lo rende accessibile."}
        }
      ]
    }
  ]
}
{% endschema %}
