{% comment %}
  This section is used in the 404 template. Instead of showing a "page not
  found" message, it sends visitors straight to the homepage: a typo, an old
  bookmark, or a link to a deleted page lands on the real site instead of a
  dead end. `replace` (not a normal navigation) so the broken URL does not
  sit in browser history, keeping the back button from bouncing to it.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<script>
  window.location.replace({{ routes.root_url | json }});
</script>

<noscript>
  <p>{{ '404.not_found' | t }}</p>
  <a href="{{ routes.root_url }}">{{ '404.back_to_shopping' | t }}</a>
</noscript>

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
