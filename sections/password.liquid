{% comment %}
  Password-protected storefront landing page, shown to visitors before the
  site goes live.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password-page">
  <a class="password-page__brand" href="{{ routes.root_url }}">
    <span class="password-page__mark">{% render 'brand-line' %}</span>
    <span class="password-page__wordmark">{{ shop.name }}</span>
  </a>

  <div class="password-page__content">
    <h1 class="password-page__title">{{ section.settings.heading }}</h1>

    {% if shop.password_message != blank %}
      <p class="password-page__message">{{ shop.password_message }}</p>
    {% elsif section.settings.message != blank %}
      <p class="password-page__message">{{ section.settings.message }}</p>
    {% endif %}

    {% form 'storefront_password', class: 'password-page__form' %}
      <label class="visually-hidden" for="password-input">{{ section.settings.password_label }}</label>

      <div class="password-page__field">
        <input
          type="password"
          name="password"
          id="password-input"
          placeholder="{{ section.settings.password_label }}"
          autocomplete="current-password"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="password-error"
          {% endif %}
        >
        <button type="submit" class="button">{{ section.settings.button_label }}</button>
      </div>

      {% if form.errors %}
        <p class="password-page__error" id="password-error" role="alert">
          {{ section.settings.error_message }}
        </p>
      {% endif %}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .password-page {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 6vw, 3rem);
    min-height: 100svh;
    padding: 3rem var(--page-margin, 1.5rem);
    text-align: center;
  }

  .password-page__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: inherit;
    text-decoration: none;
  }

  .password-page__mark {
    display: inline-flex;
    color: var(--color-accent);
  }

  .password-page__mark svg {
    display: block;
    width: 2.75rem;
    height: auto;
  }

  .password-page__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 26rem;
  }

  .password-page__title {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .password-page__message {
    margin: 0;
    color: var(--color-muted);
  }

  .password-page__form {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .password-page__field {
    display: flex;
    gap: 0.5rem;
  }

  .password-page__field input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 1px solid #8a8f84;
    border-radius: var(--radius-pill);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .password-page__field input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .password-page__field input[aria-invalid='true'] {
    border-color: #9b2c1f;
  }

  .password-page__error {
    margin: 0;
    font-size: 0.875rem;
    color: #9b2c1f;
    text-align: left;
  }

  @media (max-width: 479px) {
    .password-page__field {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .password-page__brand,
    .password-page__title,
    .password-page__message,
    .password-page__form {
      animation: password-page-rise 0.9s var(--ease-out) both;
    }

    .password-page__title {
      animation-delay: 0.08s;
    }

    .password-page__message {
      animation-delay: 0.16s;
    }

    .password-page__form {
      animation-delay: 0.24s;
    }
  }

  @keyframes password-page-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Il sito è quasi pronto"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Messaggio",
      "info": "Mostrato solo se il messaggio in Impostazioni > Preferenze non è compilato.",
      "default": "Stiamo preparando il negozio online. Se hai la password, entra pure."
    },
    {
      "type": "text",
      "id": "password_label",
      "label": "Etichetta campo password",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Etichetta pulsante",
      "default": "Entra"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Messaggio di errore",
      "default": "Password non corretta. Riprova."
    }
  ]
}
{% endschema %}
