{% comment %}
  Cultivar as an intensity scale: the three olives of the blend sit on one
  line that runs from the most intense to the most delicate, each a dot in
  its own colour with the name, an italic line and a short text under it.
  It replaced the three text cards, which read as a repeat of "Il metodo"
  (same card rail, one section apart). Each stretch of the line blends the
  colour of one dot into the next. Phones turn the scale vertical: the line
  runs down the left edge and the text sits beside each dot.
{% endcomment %}

{%- liquid
  assign count = section.blocks.size | at_least: 1
-%}

<div class="section-band full-width {{ section.settings.background }}">
<div
  class="d-blend section-band__inner section-space"
  id="{{ section.settings.anchor | default: 'terra' | handleize }}"
  style="--blend-count: {{ count }};"
>
  <div class="d-blend__head">
    {% render 'section-label', label: section.settings.label %}
    {% if section.settings.heading != blank %}
      <h2 class="d-blend__heading reveal">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="d-blend__intro reveal">{{ section.settings.text }}</p>
    {% endif %}
  </div>

  <ol class="d-blend__scale reveal" role="list">
    {% for block in section.blocks %}
      {%- liquid
        assign next = section.blocks[forloop.index]
        assign next_color = block.settings.color
        if next
          assign next_color = next.settings.color
        endif
      -%}
      <li
        class="d-blend__item"
        style="--dot: var(--blend-{{ block.settings.color }}); --next: var(--blend-{{ next_color }});"
        {{ block.shopify_attributes }}
      >
        <p class="d-blend__end">
          {%- if forloop.first -%}
            {{ section.settings.start_label }}
          {%- elsif forloop.last -%}
            {{ section.settings.end_label }}
          {%- endif -%}
        </p>
        <span class="d-blend__dot" aria-hidden="true"></span>
        <h3 class="d-blend__name">{{ block.settings.title }}</h3>
        {% if block.settings.tagline != blank %}
          <p class="d-blend__tagline">{{ block.settings.tagline }}</p>
        {% endif %}
        {% if block.settings.text != blank %}
          <p class="d-blend__text">{{ block.settings.text }}</p>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
</div>
</div>

{% stylesheet %}
  .d-blend {
    --blend-dark: var(--color-dark);
    --blend-olive: var(--color-accent-base);
    --blend-light: var(--color-logo);
    --dot-size: 1.25rem;
    --line: 3px;
  }

  .d-blend__head {
    max-width: 40rem;
    margin-bottom: clamp(2rem, 4.5vw, 3.5rem);
  }

  .d-blend__heading {
    max-width: 20ch;
    font-size: clamp(2rem, 4.2vw, 3.5rem);
  }

  .d-blend__intro {
    max-width: 46ch;
    margin-top: 1rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .d-blend__scale {
    display: grid;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .d-blend__item {
    --dot-top: 0.15rem;
    position: relative;
    padding-left: calc(var(--dot-size) + 1.25rem);
  }

  /* The stretch of line from this dot to the next one */
  .d-blend__item:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(var(--dot-top) + var(--dot-size) / 2);
    left: calc(var(--dot-size) / 2 - var(--line) / 2);
    width: var(--line);
    height: calc(100% + 2.25rem);
    border-radius: var(--line);
    background: linear-gradient(180deg, var(--dot), var(--next));
  }

  .d-blend__dot {
    position: absolute;
    top: var(--dot-top);
    left: 0;
    z-index: 1;
    width: var(--dot-size);
    height: var(--dot-size);
    border-radius: 50%;
    background-color: var(--dot);
    box-shadow: 0 0 0 0.35rem var(--section-bg, var(--color-background));
  }

  .d-blend__end {
    font-family: var(--font-accent--family);
    font-size: 1.0625rem;
    font-style: italic;
    line-height: 1.3;
    color: var(--color-muted);
  }

  .d-blend__end:empty {
    display: none;
  }

  .d-blend__name {
    font-size: clamp(1.75rem, 2.8vw, 2.5rem);
    line-height: 1.05;
  }

  .d-blend__tagline {
    margin-top: 0.4rem;
    font-family: var(--font-accent--family);
    font-size: clamp(1.2rem, 1.6vw, 1.4rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-accent);
  }

  .d-blend__text {
    max-width: 34ch;
    margin-top: 0.75rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /*
    From 700px the scale lies flat: one column per olive, the dots on a
    common line (the captions above them share one row height so the dots
    line up), the text centred under each dot.
  */
  @media (min-width: 700px) {
    .d-blend__scale {
      grid-template-columns: repeat(var(--blend-count), minmax(0, 1fr));
      gap: 0;
    }

    .d-blend__item {
      --dot-top: 2.1rem;
      padding: 0 clamp(0.75rem, 2vw, 2rem);
      text-align: center;
    }

    .d-blend__end,
    .d-blend__end:empty {
      display: block;
      height: 1.5rem;
      margin-bottom: calc(var(--dot-size) + 1.25rem);
    }

    .d-blend__dot {
      left: calc(50% - var(--dot-size) / 2);
    }

    .d-blend__item:not(:last-child)::after {
      left: 50%;
      width: 100%;
      height: var(--line);
      top: calc(var(--dot-top) + var(--dot-size) / 2 - var(--line) / 2);
      background: linear-gradient(90deg, var(--dot), var(--next));
    }

    .d-blend__text {
      margin-inline: auto;
    }
  }

  /* The line draws itself once, left to right, as the scale comes into view */
  @media (prefers-reduced-motion: no-preference) and (min-width: 700px) {
    @supports (animation-timeline: view()) {
      .d-blend__item::after {
        transform-origin: left center;
        animation: d-blend-draw linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 35%;
      }
    }
  }

  @keyframes d-blend-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dottorini blend",
  "tag": "section",
  "class": "d-blend-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section name",
      "info": "Small name at the top of the section, matching its menu link. Leave blank to hide it.",
      "default": "Cultivar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tre olive, un solo blend d'equilibrio."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "info": "Optional, one or two lines under the heading."
    },
    {
      "type": "text",
      "id": "start_label",
      "label": "Start of the scale",
      "default": "Più intenso"
    },
    {
      "type": "text",
      "id": "end_label",
      "label": "End of the scale",
      "default": "Più delicato"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "info": "The header's \"Cultivar\" link points here (/#terra).",
      "default": "terra"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "d-bg--base",
      "options": [
        { "value": "d-bg--base", "label": "Default" },
        { "value": "d-bg--tint", "label": "Tinted" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "cultivar",
      "name": "Cultivar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Cultivar"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "info": "A few words, shown in italic under the name."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "info": "Under 20 words."
        },
        {
          "type": "select",
          "id": "color",
          "label": "Dot color",
          "info": "From the most intense to the most delicate: dark, olive, light.",
          "default": "olive",
          "options": [
            { "value": "dark", "label": "Dark" },
            { "value": "olive", "label": "Olive" },
            { "value": "light", "label": "Light" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dottorini blend",
      "blocks": [
        {
          "type": "cultivar",
          "settings": {"color": "dark", "title": "Moraiolo", "tagline": "Il carattere umbro per eccellenza.", "text": "Fruttato intenso, note d'erba, amaro e piccante decisi. Dà spina dorsale al blend."}
        },
        {
          "type": "cultivar",
          "settings": {"color": "olive", "title": "Frantoiano", "tagline": "Eleganza ed armonia.", "text": "Fruttato medio, profumi floreali e di mandorla. Smussa e arrotonda, porta finezza al taglio."}
        },
        {
          "type": "cultivar",
          "settings": {"color": "light", "title": "Leccino", "tagline": "Morbidezza e gentilezza.", "text": "Fruttato delicato, sentori dolci e puliti. Bilancia l'insieme e lo rende accessibile."}
        }
      ]
    }
  ]
}
{% endschema %}
