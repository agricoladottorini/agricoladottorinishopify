{% comment %}
  Museo opening: the page title and Giuseppe's own "Chi sono", beside
  portraits of him among the olive trees taking turns in one frame. The portraits carry the opening because the
  old site's cover (the orange cart) is only 1260px wide, too soft for a
  full-bleed plate; the cart moves to the visit section, where it sits small.
  Three figures under the story (years, pieces, sections) and a link down to
  the collection. Phones: title, portraits, story, figures.
{% endcomment %}

<div class="section-band full-width {{ section.settings.background }}">
<div class="d-mintro section-band__inner section-space section-space--flush-top" id="{{ section.settings.anchor | default: 'chi-sono' | handleize }}">
  <div class="d-mintro__head reveal">
    {% render 'section-label', label: section.settings.label %}
    {% if section.settings.heading != blank %}
      <h1 class="d-mintro__title">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="d-mintro__lede">{{ section.settings.lede }}</p>
    {% endif %}
  </div>

  {%- liquid
    assign slides = ''
    if section.settings.image_main
      assign slides = slides | append: 'image_main,'
    endif
    if section.settings.image_second
      assign slides = slides | append: 'image_second,'
    endif
    if section.settings.image_third
      assign slides = slides | append: 'image_third,'
    endif
    assign slide_keys = slides | split: ','
  -%}
  {% if slide_keys.size > 0 %}
    <museo-slides class="d-mintro__media" data-interval="{{ section.settings.interval | times: 1000 }}">
      <div class="d-mintro__frame">
        {% for key in slide_keys %}
          {%- assign photo = section.settings[key] -%}
          {%- assign position = 'object-position: ' | append: photo.presentation.focal_point -%}
          <figure class="d-mintro__slide{% if forloop.first %} is-active{% endif %}" data-slide>
            {%- liquid
              if forloop.first
                assign loading = 'eager'
                assign priority = 'high'
              else
                assign loading = 'lazy'
                assign priority = 'auto'
              endif
            -%}
            {{
              photo
              | image_url: width: 1600
              | image_tag:
                widths: '500, 750, 1000, 1300, 1600',
                sizes: '(min-width: 900px) 40vw, 90vw',
                loading: loading,
                fetchpriority: priority,
                alt: photo.alt,
                style: position
            }}
          </figure>
        {% endfor %}
      </div>

      {% if slide_keys.size > 1 %}
        <div class="d-mintro__dots" role="group" aria-label="Foto">
          {% for key in slide_keys %}
            <button
              type="button"
              class="d-mintro__dot"
              data-slide-dot="{{ forloop.index0 }}"
              aria-label="Foto {{ forloop.index }} di {{ slide_keys.size }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </museo-slides>
  {% endif %}

  <div class="d-mintro__story">
    {% if section.settings.story_label != blank %}
      <h2 class="d-mintro__story-label">{{ section.settings.story_label }}</h2>
    {% endif %}
    {% if section.settings.story != blank %}
      <div class="d-mintro__text">{{ section.settings.story }}</div>
    {% endif %}
    {% if section.settings.signature != blank %}
      <p class="d-mintro__signature">{{ section.settings.signature }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <dl class="d-mintro__facts">
        {% for block in section.blocks %}
          <div class="d-mintro__fact" {{ block.shopify_attributes }}>
            <dt class="d-mintro__fact-label">{{ block.settings.label }}</dt>
            <dd class="d-mintro__fact-value">{{ block.settings.value }}</dd>
          </div>
        {% endfor %}
      </dl>
    {% endif %}

    {% if section.settings.link_label != blank %}
      <a class="button d-mintro__cta" href="{{ section.settings.link | default: '#collezione' }}">
        {{- section.settings.link_label }} <span aria-hidden="true">&darr;</span>
      </a>
    {% endif %}
  </div>
</div>
</div>

{% stylesheet %}
  .d-mintro {
    display: grid;
    grid-template-areas:
      'head'
      'media'
      'story';
    gap: clamp(2rem, 5vw, 3rem);
  }

  .d-mintro__head {
    grid-area: head;
  }

  .d-mintro__title {
    max-width: 16ch;
    font-size: clamp(2.4rem, 5.4vw, 4.5rem);
    line-height: 1.02;
    text-wrap: balance;
  }

  .d-mintro__lede {
    max-width: 34ch;
    margin-top: 1rem;
    font-family: var(--font-accent--family);
    font-size: clamp(1.3rem, 2vw, 1.75rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-accent);
  }

  /* The portraits: one frame at the photos' own 2:3 (Giuseppe stands low
     in the frame, a crop would cut him). They take turns with a slow
     crossfade and a slight settle; the dots below switch by hand. A pair
     side by side was tried first and turned down. */
  .d-mintro__media {
    grid-area: media;
    display: block;
  }

  .d-mintro__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-media);
    background-color: var(--color-surface-strong);
  }

  .d-mintro__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }

  .d-mintro__slide.is-active {
    opacity: 1;
  }

  .d-mintro__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .d-mintro__slide img {
      transform: scale(1.06);
      transition: transform 7s linear;
    }

    .d-mintro__slide.is-active img {
      transform: none;
    }
  }

  .d-mintro__dots {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 0.75rem;
  }

  .d-mintro__dot {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .d-mintro__dot::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-surface-strong);
    transition: background-color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  .d-mintro__dot[aria-current='true']::before {
    background-color: var(--color-accent);
    transform: scale(1.25);
  }

  .d-mintro__story {
    grid-area: story;
    max-width: 40rem;
  }

  .d-mintro__story-label {
    margin-bottom: 1rem;
    font-family: var(--font-accent--family);
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-style: italic;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .d-mintro__text p {
    line-height: 1.7;
    text-wrap: pretty;
  }

  .d-mintro__text p + p {
    margin-top: 1.1em;
  }

  .d-mintro__signature {
    margin-top: 1.5rem;
    font-family: var(--font-accent--family);
    font-size: 1.3rem;
    font-style: italic;
    color: var(--color-muted);
  }

  /* Three figures in a row between hairlines */
  .d-mintro__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    border-top: 1px solid var(--color-surface-strong);
    border-bottom: 1px solid var(--color-surface-strong);
  }

  .d-mintro__fact {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.3rem;
    padding: 1.1rem 0.75rem 1.2rem 0;
  }

  .d-mintro__fact + .d-mintro__fact {
    padding-left: 0.9rem;
    border-left: 1px solid var(--color-surface-strong);
  }

  .d-mintro__fact-value {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    color: var(--color-foreground);
  }

  .d-mintro__fact-label {
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--color-muted);
  }

  .d-mintro__cta {
    margin-top: 2rem;
  }

  /* From 900px: text on the left, the portraits on the right and sticky,
     so they stay beside the story while it is read */
  @media (min-width: 900px) {
    .d-mintro {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      grid-template-areas:
        'head media'
        'story media';
      grid-template-rows: auto 1fr;
      column-gap: clamp(3rem, 6vw, 6rem);
      row-gap: clamp(2rem, 3.5vw, 3rem);
    }

    .d-mintro__media {
      align-self: start;
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
    }
  }
{% endstylesheet %}

{% javascript %}
  class MuseoSlides extends HTMLElement {
    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll('[data-slide]'));
      this.dots = Array.from(this.querySelectorAll('[data-slide-dot]'));
      if (this.slides.length < 2) return;
      this.index = 0;
      this.interval = Number(this.dataset.interval) || 6000;
      this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      this.dots.forEach((dot) =>
        dot.addEventListener('click', () => {
          this.go(Number(dot.dataset.slideDot));
          this.restart();
        })
      );

      // Only run while on screen and the tab is visible
      this.visible = false;
      this.observer = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        this.restart();
      });
      this.observer.observe(this);
      this.onVisibility = () => this.restart();
      document.addEventListener('visibilitychange', this.onVisibility);
    }

    go(index) {
      const count = this.slides.length;
      this.index = ((index % count) + count) % count;
      this.slides.forEach((slide, i) => slide.classList.toggle('is-active', i === this.index));
      this.dots.forEach((dot, i) => dot.toggleAttribute('aria-current', i === this.index));
      this.dots.forEach((dot, i) => i === this.index && dot.setAttribute('aria-current', 'true'));
    }

    restart() {
      clearInterval(this.timer);
      if (this.reduced || !this.visible || document.hidden) return;
      this.timer = setInterval(() => this.go(this.index + 1), this.interval);
    }

    disconnectedCallback() {
      clearInterval(this.timer);
      this.observer?.disconnect();
      document.removeEventListener('visibilitychange', this.onVisibility);
    }
  }

  if (!customElements.get('museo-slides')) customElements.define('museo-slides', MuseoSlides);
{% endjavascript %}

{% schema %}
{
  "name": "Museo apertura",
  "tag": "section",
  "class": "d-mintro-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "label", "label": "Section name", "default": "Museo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Piccolo Museo della Civiltà Contadina" },
    { "type": "text", "id": "lede", "label": "Line under the heading", "default": "La raccolta di Giuseppe Belardi Dottorini, a Collazzone." },
    { "type": "image_picker", "id": "image_main", "label": "Photo 1", "info": "Portraits take turns in one 2:3 frame. Upright photos work best." },
    { "type": "image_picker", "id": "image_second", "label": "Photo 2" },
    { "type": "image_picker", "id": "image_third", "label": "Photo 3" },
    { "type": "range", "id": "interval", "label": "Seconds per photo", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 },
    { "type": "text", "id": "story_label", "label": "Story heading", "default": "Chi sono" },
    { "type": "richtext", "id": "story", "label": "Story" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Giuseppe Belardi Dottorini" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Guarda la collezione", "info": "Leave blank to hide." },
    { "type": "text", "id": "link", "label": "Link target", "default": "#collezione" },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "chi-sono" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "d-bg--base",
      "options": [
        { "value": "d-bg--base", "label": "Default" },
        { "value": "d-bg--tint", "label": "Tinted" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Figure",
      "settings": [
        { "type": "text", "id": "value", "label": "Figure", "default": "400" },
        { "type": "text", "id": "label", "label": "Label", "default": "pezzi" }
      ]
    }
  ],
  "presets": [{ "name": "Museo apertura" }]
}
{% endschema %}
