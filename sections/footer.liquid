{%- liquid
  assign has_legal = false
  if section.settings.company_name != blank
    assign has_legal = true
  endif
  if section.settings.vat != blank
    assign has_legal = true
  endif
  if section.settings.fiscal_code != blank
    assign has_legal = true
  endif
  if section.settings.rea != blank
    assign has_legal = true
  endif
  if section.settings.share_capital != blank
    assign has_legal = true
  endif
  if section.settings.address != blank
    assign has_legal = true
  endif

  assign menu_count = 0
  for link in section.settings.menu.links
    unless link.url contains routes.search_url
      assign menu_count = menu_count | plus: 1
    endunless
  endfor

  assign has_contact = false
  if section.settings.email != blank
    assign has_contact = true
  endif
  if section.settings.phone != blank
    assign has_contact = true
  endif
  if section.settings.pec != blank
    assign has_contact = true
  endif
-%}

<footer class="site-footer full-width {{ section.settings.background }}">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__newsletter">
        {% if section.settings.newsletter_heading != blank %}
          <h2 class="site-footer__heading">{{ section.settings.newsletter_heading }}</h2>
        {% endif %}

        {% assign form_id = 'Newsletter-' | append: section.id %}
        {% form 'customer', id: form_id, class: 'site-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {% if form.posted_successfully? %}
            <p class="site-footer__status" role="status">{{ section.settings.success_message }}</p>
          {% else %}
            <label class="site-footer__label" for="NewsletterEmail-{{ section.id }}">
              {{- section.settings.email_label -}}
            </label>
            <div class="site-footer__field">
              <input
                id="NewsletterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                aria-describedby="NewsletterHelp-{{ section.id }}{% if form.errors %} NewsletterError-{{ section.id }}{% endif %}"
                {% if form.errors %}
                  aria-invalid="true"
                {% endif %}
              >
              <button type="submit" class="button">{{ section.settings.button_label }}</button>
            </div>
            <p class="site-footer__help" id="NewsletterHelp-{{ section.id }}">{{ section.settings.helper_text }}</p>
            {% if form.errors %}
              <p class="site-footer__error" id="NewsletterError-{{ section.id }}" role="alert">
                {{ section.settings.error_message }}
              </p>
            {% endif %}
          {% endif %}
        {% endform %}
      </div>

      {% comment %}
        Search links are skipped here: search now lives in the header. Remove
        the entry from the footer menu in Shopify navigation to drop it for good.
      {% endcomment %}
      {% if menu_count > 0 %}
        <nav class="site-footer__column" aria-label="{{ section.settings.menu.title | escape }}">
          {% if section.settings.menu_title != blank %}
            <h3 class="site-footer__column-title">{{ section.settings.menu_title }}</h3>
          {% endif %}
          {% for link in section.settings.menu.links %}
            {% unless link.url contains routes.search_url %}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {% endunless %}
          {% endfor %}
        </nav>
      {% endif %}

      {% if has_contact %}
        <div class="site-footer__column">
          {% if section.settings.contact_title != blank %}
            <h3 class="site-footer__column-title">{{ section.settings.contact_title }}</h3>
          {% endif %}
          {% if section.settings.email != blank %}
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          {% endif %}
          {% if section.settings.phone != blank %}
            {% assign phone_href = section.settings.phone | remove: ' ' %}
            <a href="tel:{{ phone_href }}">{{ section.settings.phone }}</a>
          {% endif %}
          {% if section.settings.pec != blank %}
            <a href="mailto:{{ section.settings.pec }}">PEC {{ section.settings.pec }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if has_legal %}
      <dl class="site-footer__legal">
        {% if section.settings.company_name != blank %}
          <div class="site-footer__legal-item">
            <dt>{{ section.settings.company_label }}</dt>
            <dd>{{ section.settings.company_name }}</dd>
          </div>
        {% endif %}
        {% if section.settings.address != blank %}
          <div class="site-footer__legal-item">
            <dt>{{ section.settings.address_label }}</dt>
            <dd>{{ section.settings.address }}</dd>
          </div>
        {% endif %}
        {% if section.settings.vat != blank %}
          <div class="site-footer__legal-item">
            <dt>P. IVA</dt>
            <dd>{{ section.settings.vat }}</dd>
          </div>
        {% endif %}
        {% if section.settings.fiscal_code != blank %}
          <div class="site-footer__legal-item">
            <dt>Codice fiscale</dt>
            <dd>{{ section.settings.fiscal_code }}</dd>
          </div>
        {% endif %}
        {% if section.settings.rea != blank %}
          <div class="site-footer__legal-item">
            <dt>{{ section.settings.rea_label }}</dt>
            <dd>{{ section.settings.rea }}</dd>
          </div>
        {% endif %}
        {% if section.settings.share_capital != blank %}
          <div class="site-footer__legal-item">
            <dt>Capitale sociale</dt>
            <dd>{{ section.settings.share_capital }}</dd>
          </div>
        {% endif %}
      </dl>
    {% endif %}

    <p class="site-footer__wordmark" aria-hidden="true">{{ section.settings.wordmark | default: shop.name }}</p>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}
      </p>

      {% if shop.policies.size > 0 %}
        <nav class="site-footer__policies" aria-label="{{ section.settings.policies_label | escape }}">
          {% for policy in shop.policies %}
            <a href="{{ policy.url }}">{{ policy.title }}</a>
          {% endfor %}
        </nav>
      {% endif %}

      {% if section.settings.show_payment_icons %}
        <ul class="site-footer__payment" role="list">
          {% for type in shop.enabled_payment_types %}
            <li>{{ type | payment_type_svg_tag }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    display: grid;
    grid-template-columns: var(--content-grid);
    margin-top: var(--section-space);
    color: var(--color-foreground);
  }

  .site-footer.d-bg--base {
    border-top: 1px solid var(--color-surface-strong);
  }

  .site-footer__inner {
    grid-column: 2;
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }

  .site-footer a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-accent);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .site-footer__heading {
    max-width: 18ch;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    letter-spacing: -0.03em;
  }

  .site-footer__form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 30rem;
    margin-top: 1.5rem;
  }

  .site-footer__label {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .site-footer__field {
    display: flex;
    gap: 0.5rem;
  }

  .site-footer__field input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 1px solid #8a8f84;
    border-radius: var(--radius-pill);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .site-footer__field input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .site-footer__field input[aria-invalid='true'] {
    border-color: #9b2c1f;
  }

  .site-footer__help {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .site-footer__error {
    font-size: 0.875rem;
    color: #9b2c1f;
  }

  .site-footer__status {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-strong);
  }

  .site-footer__column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .site-footer__column-title {
    margin-bottom: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Company details required for selling in Italy */
  .site-footer__legal {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.5rem 1.25rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-surface-strong);
  }

  .site-footer__legal-item dt {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .site-footer__legal-item dd {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .site-footer__wordmark {
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 0;
    font-size: clamp(4rem, 17.5vw, 17rem);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.06em;
    white-space: nowrap;
    overflow: hidden;
    color: var(--color-surface-strong);
    user-select: none;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding: 1.5rem 0 2rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .site-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .site-footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__payment svg {
    width: 2.25rem;
    height: auto;
  }

  /* Under 900px: newsletter, menu and contact stack in one column */
  @media (min-width: 900px) {
    .site-footer__top {
      grid-template-columns: 6fr 3fr 3fr;
      gap: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Notizie dal frantoio, poche volte l'anno."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "La tua email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Iscriviti"
    },
    {
      "type": "text",
      "id": "helper_text",
      "label": "Helper text",
      "default": "Puoi cancellarti in qualsiasi momento."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Grazie, la tua iscrizione è confermata."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Controlla l'indirizzo email e riprova."
    },
    {
      "type": "header",
      "content": "Links and contact"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "menu_title",
      "label": "Menu column title",
      "default": "Negozio"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Contact column title",
      "default": "Contatti"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "info": "Shown as a mailto link.",
      "default": "info@agricoladottorini.it"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "info": "Shown as a tel link. SAMPLE value, replace it.",
      "default": "+39 075 1234567"
    },
    {
      "type": "text",
      "id": "pec",
      "label": "PEC",
      "info": "Optional."
    },
    {
      "type": "header",
      "content": "Company details (required in Italy)"
    },
    {
      "type": "text",
      "id": "company_label",
      "label": "Company name label",
      "default": "Ragione sociale"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company name",
      "info": "Full registered name, as it appears on invoices. SAMPLE value, replace it.",
      "default": "Azienda Agricola Dottorini"
    },
    {
      "type": "text",
      "id": "address_label",
      "label": "Address label",
      "default": "Sede legale"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Registered address",
      "info": "Street, postcode, town, province. SAMPLE value, replace it.",
      "default": "Via del Frantoio 12, 06089 Torgiano (PG)"
    },
    {
      "type": "text",
      "id": "vat",
      "label": "Partita IVA",
      "info": "SAMPLE value, replace it before publishing.",
      "default": "01234567890"
    },
    {
      "type": "text",
      "id": "fiscal_code",
