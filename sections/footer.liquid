    },
    {
      "type": "text",
      "id": "rea_label",
      "label": "REA label",
      "default": "REA"
    },
    {
      "type": "text",
      "id": "rea",
      "label": "REA or Registro Imprese number",
      "info": "SAMPLE value, replace it before publishing.",
      "default": "PG 123456"
    },
    {
      "type": "text",
      "id": "share_capital",
      "label": "Capitale sociale",
      "info": "Only for companies with share capital."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "policies_label",
      "label": "Policy links label (for screen readers)",
      "default": "Note legali"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Large wordmark",
      "default": "Dottorini"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "d-bg--base",
      "options": [
        { "value": "d-bg--base", "label": "Default" },
        { "value": "d-bg--tint", "label": "Tinted" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
