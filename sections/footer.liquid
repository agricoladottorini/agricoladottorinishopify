<footer class="site-footer full-width {{ section.settings.background }}">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__newsletter">
        {% if section.settings.newsletter_heading != blank %}
          <h2 class="site-footer__heading">{{ section.settings.newsletter_heading }}</h2>
        {% endif %}

        {% assign form_id = 'Newsletter-' | append: section.id %}
        {% form 'customer', id: form_id, class: 'site-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {% if form.posted_successfully? %}
            <p class="site-footer__status" role="status">{{ section.settings.success_message }}</p>
          {% else %}
            <label class="site-footer__label" for="NewsletterEmail-{{ section.id }}">
              {{- section.settings.email_label -}}
            </label>
            <div class="site-footer__field">
              <input
                id="NewsletterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                aria-describedby="NewsletterHelp-{{ section.id }}{% if form.errors %} NewsletterError-{{ section.id }}{% endif %}"
                {% if form.errors %}
                  aria-invalid="true"
                {% endif %}
              >
              <button type="submit" class="button">{{ section.settings.button_label }}</button>
            </div>
            <p class="site-footer__help" id="NewsletterHelp-{{ section.id }}">{{ section.settings.helper_text }}</p>
            {% if form.errors %}
              <p class="site-footer__error" id="NewsletterError-{{ section.id }}" role="alert">
                {{ section.settings.error_message }}
              </p>
            {% endif %}
          {% endif %}
        {% endform %}
      </div>

      {% if section.settings.menu.links.size > 0 %}
        <nav class="site-footer__links" aria-label="{{ section.settings.menu.title | escape }}">
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        </nav>
      {% endif %}

      {% if section.settings.contact != blank %}
        <div class="site-footer__contact">{{ section.settings.contact }}</div>
      {% endif %}
    </div>

    <p class="site-footer__wordmark" aria-hidden="true">{{ section.settings.wordmark | default: shop.name }}</p>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</p>

      {% if section.settings.show_payment_icons %}
        <ul class="site-footer__payment" role="list">
          {% for type in shop.enabled_payment_types %}
            <li>{{ type | payment_type_svg_tag }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    display: grid;
    grid-template-columns: var(--content-grid);
    margin-top: var(--section-space);
    color: var(--color-foreground);
  }

  .site-footer.d-bg--base {
    border-top: 1px solid var(--color-surface-strong);
  }

  .site-footer__inner {
    grid-column: 2;
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }

  .site-footer a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-accent);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .site-footer__heading {
    max-width: 18ch;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    letter-spacing: -0.03em;
  }

  .site-footer__form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 30rem;
    margin-top: 1.5rem;
  }

  .site-footer__label {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .site-footer__field {
    display: flex;
    gap: 0.5rem;
  }

  .site-footer__field input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 1px solid #8a8f84;
    border-radius: var(--radius-pill);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .site-footer__field input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .site-footer__field input[aria-invalid='true'] {
    border-color: #9b2c1f;
  }

  .site-footer__help {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .site-footer__error {
    font-size: 0.875rem;
    color: #9b2c1f;
  }

  .site-footer__status {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-strong);
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .site-footer__contact {
    color: var(--color-muted);
  }

  .site-footer__contact p + p {
    margin-top: 0.5rem;
  }

  .site-footer__wordmark {
    margin: clamp(3rem, 8vw, 6rem) 0 0;
    font-size: clamp(4rem, 17.5vw, 17rem);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.06em;
    white-space: nowrap;
    overflow: hidden;
    color: var(--color-surface-strong);
    user-select: none;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 0 2rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .site-footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__payment svg {
    width: 2.25rem;
    height: auto;
  }

  /* Under 900px: newsletter, links and contact stack in one column */
  @media (min-width: 900px) {
    .site-footer__top {
      grid-template-columns: 6fr 3fr 3fr;
      gap: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Notizie dal frantoio, poche volte l'anno."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "La tua email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Iscriviti"
    },
    {
      "type": "text",
      "id": "helper_text",
      "label": "Helper text",
      "default": "Puoi cancellarti in qualsiasi momento."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Grazie, la tua iscrizione è confermata."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Controlla l'indirizzo email e riprova."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "footer"
    },
    {
      "type": "richtext",
      "id": "contact",
      "label": "Contact",
      "info": "Address, email or phone."
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Large wordmark",
      "default": "Dottorini"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "d-bg--base",
      "options": [
        { "value": "d-bg--base", "label": "Default" },
        { "value": "d-bg--tint", "label": "Tinted" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
