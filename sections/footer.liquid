{%- liquid
  assign has_legal = false
  if section.settings.company_name != blank
    assign has_legal = true
  endif
  if section.settings.vat != blank
    assign has_legal = true
  endif
  if section.settings.fiscal_code != blank
    assign has_legal = true
  endif
  if section.settings.share_capital != blank
    assign has_legal = true
  endif
  if section.settings.address != blank
    assign has_legal = true
  endif

  assign has_contact = false
  if section.settings.email != blank
    assign has_contact = true
  endif
  if section.settings.phone != blank
    assign has_contact = true
  endif
  if section.settings.pec != blank
    assign has_contact = true
  endif
-%}

{% comment %}
  Company data for search engines, homepage only. Held back while the
  Partita IVA is still the schema's sample value, so placeholder details
  are never published as real ones.
{% endcomment %}
{%- if request.page_type == 'index' and section.settings.vat != '01234567890' -%}
  {% render 'organization-structured-data',
    name: shop.name,
    legal_name: section.settings.company_name,
    address: section.settings.address,
    phone: section.settings.phone,
    email: section.settings.email,
    vat: section.settings.vat
  %}
{%- endif -%}

<footer id="contatti" class="site-footer full-width {{ section.settings.background }}">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__lead">
        {%- assign wordmark = section.settings.wordmark | default: shop.name -%}
        <a class="site-footer__brand" href="{{ routes.root_url }}">
          <span class="site-footer__logo">{% render 'brand-logo' %}</span>
          <span class="site-footer__words">
            <span class="site-footer__name">{{ wordmark }}</span>
            {%- if section.settings.tagline != blank -%}
              <span class="site-footer__tagline">{{ section.settings.tagline }}</span>
            {%- endif -%}
          </span>
        </a>

        {% if section.settings.show_newsletter %}
        <div class="site-footer__newsletter">
          {% if section.settings.newsletter_heading != blank %}
            <h2 class="site-footer__heading">{{ section.settings.newsletter_heading }}</h2>
          {% endif %}

          {% assign form_id = 'Newsletter-' | append: section.id %}
          {% form 'customer', id: form_id, class: 'site-footer__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {% if form.posted_successfully? %}
              <p class="site-footer__status" role="status">{{ section.settings.success_message }}</p>
            {% else %}
              <label class="site-footer__label" for="NewsletterEmail-{{ section.id }}">
                {{- section.settings.email_label -}}
              </label>
              <div class="site-footer__field">
                <input
                  id="NewsletterEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  autocapitalize="off"
                  spellcheck="false"
                  required
                  aria-describedby="NewsletterHelp-{{ section.id }}{% if form.errors %} NewsletterError-{{ section.id }}{% endif %}"
                  {% if form.errors %}
                    aria-invalid="true"
                  {% endif %}
                >
                <button type="submit" class="button">{{ section.settings.button_label }}</button>
              </div>
              <p class="site-footer__help" id="NewsletterHelp-{{ section.id }}">{{ section.settings.helper_text }}</p>
              {% if form.errors %}
                <p class="site-footer__error" id="NewsletterError-{{ section.id }}" role="alert">
                  {{ section.settings.error_message }}
                </p>
              {% endif %}
            {% endif %}
          {% endform %}
        </div>
        {% endif %}
      </div>

      {%- liquid
        assign has_nav = false
        for i in (1..4)
          assign label_key = 'nav_' | append: i | append: '_label'
          if section.settings[label_key] != blank
            assign has_nav = true
          endif
        endfor
      -%}
      {% if has_nav %}
        <nav class="site-footer__column" aria-label="{{ section.settings.nav_title | escape }}">
          {% if section.settings.nav_title != blank %}
            <h3 class="site-footer__column-title">{{ section.settings.nav_title }}</h3>
          {% endif %}
          {%- for i in (1..4) -%}
            {%- liquid
              assign label_key = 'nav_' | append: i | append: '_label'
              assign href_key = 'nav_' | append: i | append: '_href'
            -%}
            {%- if section.settings[label_key] != blank -%}
              <a class="site-footer__link" href="{{ section.settings[href_key] | default: '#' }}">{{ section.settings[label_key] | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {% endif %}

      {% if section.settings.table_label != blank %}
        <div class="site-footer__column">
          {% if section.settings.table_title != blank %}
            <h3 class="site-footer__column-title">{{ section.settings.table_title }}</h3>
          {% endif %}
          <a
            class="site-footer__feature"
            href="{{ section.settings.table_href | default: '#' }}"
            {% if section.settings.table_href contains '://' %}
              target="_blank" rel="noopener"
            {% endif %}
          >
            {{- section.settings.table_label | escape }} <span aria-hidden="true">&#8599;</span>
          </a>
        </div>
      {% endif %}

      {% if has_contact %}
        <div class="site-footer__column">
          {% if section.settings.contact_title != blank %}
            <h3 class="site-footer__column-title">{{ section.settings.contact_title }}</h3>
          {% endif %}
          {% if section.settings.email != blank %}
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          {% endif %}
          {% if section.settings.phone != blank %}
            {% assign phone_href = section.settings.phone | remove: ' ' %}
            <a href="tel:{{ phone_href }}">{{ section.settings.phone }}</a>
          {% endif %}
          {% if section.settings.pec != blank %}
            <a href="mailto:{{ section.settings.pec }}">PEC {{ section.settings.pec }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if has_legal %}
      <dl class="site-footer__legal">
        {% if section.settings.company_name != blank %}
          <div class="site-footer__legal-item">
            <dt>{{ section.settings.company_label }}</dt>
            <dd>{{ section.settings.company_name }}</dd>
          </div>
        {% endif %}
        {% if section.settings.address != blank %}
          <div class="site-footer__legal-item">
            <dt>{{ section.settings.address_label }}</dt>
            <dd>{{ section.settings.address }}</dd>
          </div>
        {% endif %}
        {% if section.settings.vat != blank %}
          <div class="site-footer__legal-item">
            <dt>P. IVA</dt>
            <dd>{{ section.settings.vat }}</dd>
          </div>
        {% endif %}
        {% if section.settings.fiscal_code != blank %}
          <div class="site-footer__legal-item">
            <dt>Codice fiscale</dt>
            <dd>{{ section.settings.fiscal_code }}</dd>
          </div>
        {% endif %}
        {% if section.settings.share_capital != blank %}
          <div class="site-footer__legal-item">
            <dt>Capitale sociale</dt>
            <dd>{{ section.settings.share_capital }}</dd>
          </div>
        {% endif %}
      </dl>
    {% endif %}

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}
      </p>

      {% if shop.policies.size > 0 %}
        <nav class="site-footer__policies" aria-label="{{ section.settings.policies_label | escape }}">
          {% for policy in shop.policies %}
            <a href="{{ policy.url }}">{{ policy.title }}</a>
          {% endfor %}
        </nav>
      {% endif %}

      {% if section.settings.show_payment_icons %}
        <ul class="site-footer__payment" role="list">
          {% for type in shop.enabled_payment_types %}
            <li>{{ type | payment_type_svg_tag }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    /* clears the sticky header when jumped to from the menu */
    scroll-margin-top: var(--header-height);
    display: grid;
    grid-template-columns: var(--content-grid);
    margin-top: var(--section-space);
    color: var(--color-foreground);
  }

  /* After a section band the band's own bottom padding is the gap; the
     footer's margin would add a strip of page colour between two grounds */
  .shopify-section:has(> .section-band) + .shopify-section-group-footer-group .site-footer {
    margin-top: 0;
  }

  /* The last band only has to close the page, not separate two sections:
     its full bottom padding plus the footer's own top padding left a dead
     strip of colour between the last content and the footer */
  .shopify-section:has(> .section-band):has(+ .shopify-section-group-footer-group) .section-band__inner {
    padding-bottom: calc(var(--section-space) / 2);
  }

  .site-footer.d-bg--base {
    border-top: 1px solid var(--color-surface-strong);
  }

  .site-footer__inner {
    grid-column: 2;
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }

  .site-footer a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-accent);
  }

  /* minmax(0, 1fr), not 1fr, so no column's content can widen the track
     past a small phone's screen (see Gotchas in DESIGN.md) */
  .site-footer__top {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.25rem;
  }

  /* Phones: brand and contacts take the full width, "Naviga" and "In tavola"
     sit side by side between them */
  .site-footer__lead,
  .site-footer__top > :last-child {
    grid-column: 1 / -1;
  }

  .site-footer__lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  /* Same mark and wordmark as the header, name over tagline */
  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    color: var(--color-foreground);
    text-decoration: none;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 5vw, 1.75rem);
  }

  .site-footer__logo {
    flex: 0 0 auto;
    margin-right: 0.75rem;
    color: var(--color-logo);
  }

  .site-footer__logo svg {
    display: block;
    width: clamp(4rem, 14vw, 5.5rem);
    height: auto;
  }

  .site-footer__words {
    display: flex;
    flex-direction: column;
  }

  .site-footer__name {
    line-height: 1.1;
  }

  .site-footer__tagline {
    font-family: var(--font-accent--family);
    font-size: 0.8em;
    font-style: italic;
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-accent);
  }

  .site-footer__link {
    font-size: 1.0625rem;
  }

  .site-footer a.site-footer__feature {
    font-family: var(--font-heading--family);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.15;
    color: #e0966f;
  }

  .site-footer__feature span {
    font-size: 0.75em;
  }

  .site-footer__heading {
    max-width: 18ch;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
  }

  .site-footer__form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 30rem;
    margin-top: 1.5rem;
  }

  .site-footer__label {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .site-footer__field {
    display: flex;
    gap: 0.5rem;
  }

  .site-footer__field input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 1px solid var(--color-field-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .site-footer__field input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .site-footer__field input[aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .site-footer__help {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .site-footer__error {
    font-size: 0.875rem;
    color: var(--color-error);
  }

  .site-footer__status {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-strong);
  }

  .site-footer__column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .site-footer__column-title {
    margin-bottom: 0.25rem;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Company details required for selling in Italy */
  .site-footer__legal {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: 1.5rem 1.25rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-surface-strong);
  }

  .site-footer__legal-item dt {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .site-footer__legal-item dd {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-surface-strong);
    /* Clears the phone browser toolbar and the home indicator, so the policy
       links and payment icons are never stuck under them. */
    padding: 1.5rem 0 max(3.5rem, calc(env(safe-area-inset-bottom, 0px) + 2.5rem));
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  /* Phones: give the last row room to breathe and make the links tappable */
  @media (max-width: 899px) {
    /* Items flow inline and only wrap when they do not fit the width */
    .site-footer__bottom {
      justify-content: flex-start;
      gap: 0.25rem 1.25rem;
      padding-top: 1.75rem;
    }

    .site-footer__policies {
      gap: 0 1.25rem;
    }

    .site-footer__bottom .site-footer__payment {
      margin-top: 0.75rem;
    }

    .site-footer__policies a {
      padding: 0.4rem 0;
    }
  }

  @media (min-width: 900px) {
    .site-footer__bottom {
      padding-bottom: 2rem;
    }
  }

  /* The logo sits on its own row above the copyright */
  .site-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .site-footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__payment svg {
    width: 2.25rem;
    height: auto;
  }

  /* From 900px one row of four columns */
  @media (min-width: 900px) {
    .site-footer__top {
      grid-template-columns: 5fr 2fr 3fr 2.5fr;
      gap: 2rem 1.5rem;
    }

    .site-footer__lead,
    .site-footer__top > :last-child {
      grid-column: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Name",
      "info": "Leave blank to use the shop name."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "L'olio di Collazzone"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "text",
      "id": "nav_title",
      "label": "Navigation title",
      "default": "Naviga"
    },
    { "type": "text", "id": "nav_1_label", "label": "Link 1 label", "default": "La collina" },
    { "type": "text", "id": "nav_1_href", "label": "Link 1 URL", "default": "/#collina" },
    { "type": "text", "id": "nav_2_label", "label": "Link 2 label", "default": "L'olio" },
    { "type": "text", "id": "nav_2_href", "label": "Link 2 URL", "default": "/collections/all" },
    { "type": "text", "id": "nav_3_label", "label": "Link 3 label", "default": "Cultivar" },
    { "type": "text", "id": "nav_3_href", "label": "Link 3 URL", "default": "/#terra" },
    { "type": "text", "id": "nav_4_label", "label": "Link 4 label", "default": "Contatti" },
    { "type": "text", "id": "nav_4_href", "label": "Link 4 URL", "default": "#contatti" },
    {
      "type": "text",
      "id": "table_title",
      "label": "Featured link title",
      "default": "In tavola"
    },
    { "type": "text", "id": "table_label", "label": "Featured link label", "default": "Convivia Home Restaurant" },
    { "type": "text", "id": "table_href", "label": "Featured link URL", "default": "https://www.conviviahomerestaurant.it/" },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": false
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Notizie dal frantoio, poche volte l'anno."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "La tua email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Iscriviti"
    },
    {
      "type": "text",
      "id": "helper_text",
      "label": "Helper text",
      "default": "Puoi cancellarti in qualsiasi momento."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Grazie, la tua iscrizione è confermata."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Controlla l'indirizzo email e riprova."
    },
    {
      "type": "header",
      "content": "Links and contact"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Contact column title",
      "default": "Contatti"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "info": "Shown as a mailto link.",
      "default": "info@agricoladottorini.it"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "info": "Shown as a tel link. SAMPLE value, replace it.",
      "default": "+39 075 1234567"
    },
    {
      "type": "text",
      "id": "pec",
      "label": "PEC",
      "info": "Optional."
    },
    {
      "type": "header",
      "content": "Company details (required in Italy)"
    },
    {
      "type": "text",
      "id": "company_label",
      "label": "Company name label",
      "default": "Ragione sociale"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company name",
      "info": "Full registered name, as it appears on invoices. SAMPLE value, replace it.",
      "default": "Azienda Agricola Dottorini"
    },
    {
      "type": "text",
      "id": "address_label",
      "label": "Address label",
      "default": "Sede legale"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Registered address",
      "info": "Street, postcode, town, province. SAMPLE value, replace it.",
      "default": "Via del Frantoio 12, 06089 Torgiano (PG)"
    },
    {
      "type": "text",
      "id": "vat",
      "label": "Partita IVA",
      "info": "SAMPLE value, replace it before publishing.",
      "default": "01234567890"
    },
    {
      "type": "text",
      "id": "fiscal_code",
      "label": "Codice fiscale",
      "info": "Leave empty if it matches the Partita IVA."
    },
    {
      "type": "text",
      "id": "share_capital",
      "label": "Capitale sociale",
      "info": "Only for companies with share capital."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "policies_label",
      "label": "Policy links label (for screen readers)",
      "default": "Note legali"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "d-bg--dark",
      "options": [
        { "value": "d-bg--base", "label": "Default" },
        { "value": "d-bg--tint", "label": "Tinted" },
        { "value": "d-bg--dark", "label": "Dark" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
