{% comment %}
  Offset collage split: two overlapping images on one side, a short origin
  story and a compact list of facts on the other.
{% endcomment %}

<div class="d-origin section-space" id="{{ section.settings.anchor | default: 'terra' | handleize }}">
  <div class="d-origin__collage">
    <div class="d-origin__image d-origin__image--main reveal">
      {% if section.settings.image_main %}
        {% assign image_position = 'object-position: ' | append: section.settings.image_main.presentation.focal_point %}
        {{
          section.settings.image_main
          | image_url: width: 1600
          | image_tag:
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 900px) 40vw, 90vw',
            loading: 'lazy',
            alt: section.settings.image_main.alt,
            style: image_position
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'd-origin__placeholder' }}
      {% endif %}
    </div>

    <div class="d-origin__image d-origin__image--detail reveal">
      {% if section.settings.image_detail %}
        {% assign image_position = 'object-position: ' | append: section.settings.image_detail.presentation.focal_point %}
        {{
          section.settings.image_detail
          | image_url: width: 900
          | image_tag:
            widths: '400, 600, 900',
            sizes: '(min-width: 900px) 20vw, 45vw',
            loading: 'lazy',
            alt: section.settings.image_detail.alt,
            style: image_position
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'd-origin__placeholder' }}
      {% endif %}
    </div>
  </div>

  <div class="d-origin__content reveal">
    {% if section.settings.eyebrow != blank %}
      <p class="d-origin__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="d-origin__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="d-origin__text">{{ section.settings.text }}</div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <dl class="d-origin__facts">
        {% for block in section.blocks %}
          <div class="d-origin__fact" {{ block.shopify_attributes }}>
            <dt>{{ block.settings.label }}</dt>
            <dd>{{ block.settings.value }}</dd>
          </div>
        {% endfor %}
      </dl>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .d-origin {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .d-origin__collage {
    position: relative;
    padding-bottom: 18%;
  }

  .d-origin__image {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-media);
    background-color: var(--color-surface-strong);
  }

  .d-origin__image--main {
    width: 82%;
    aspect-ratio: 3 / 4;
  }

  .d-origin__image--detail {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 1 / 1;
    background-color: var(--color-surface);
    box-shadow: 0 0 0 0.5rem var(--color-background);
  }

  .d-origin__image img,
  .d-origin__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d-origin__placeholder {
    fill: rgb(30 34 29 / 0.14);
  }

  .d-origin__eyebrow {
    margin-bottom: 1.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .d-origin__heading {
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    letter-spacing: -0.035em;
  }

  .d-origin__text {
    max-width: 42ch;
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    color: var(--color-muted);
  }

  .d-origin__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-surface-strong);
  }

  .d-origin__fact dt {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .d-origin__fact dd {
    margin: 0.25rem 0 0;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* Under 900px: collage stacks above the copy */
  @media (min-width: 900px) {
    .d-origin {
      grid-template-columns: repeat(12, 1fr);
      column-gap: 1.25rem;
      align-items: center;
    }

    .d-origin__collage {
      grid-column: 1 / span 6;
    }

    .d-origin__content {
      grid-column: 8 / span 5;
    }

    .d-origin__image--detail {
      animation-range: entry 15% cover 40%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dottorini origin",
  "tag": "section",
  "class": "d-origin-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "image_main",
      "label": "Main image",
      "info": "Portrait photo, 3:4."
    },
    {
      "type": "image_picker",
      "id": "image_detail",
      "label": "Detail image",
      "info": "Square close-up."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Azienda Agricola Dottorini"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Dalle colline dell'Umbria."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Un'azienda agricola di famiglia. Curiamo i nostri olivi a mano e seguiamo ogni bottiglia, dalla pianta alla tavola.</p>"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "terra"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Origine"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Umbria"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dottorini origin",
      "blocks": [
        { "type": "fact", "settings": { "label": "Origine", "value": "Umbria" } },
        { "type": "fact", "settings": { "label": "Categoria", "value": "Extravergine" } },
        { "type": "fact", "settings": { "label": "Raccolta", "value": "Ottobre, novembre" } }
      ]
    }
  ]
}
{% endschema %}
