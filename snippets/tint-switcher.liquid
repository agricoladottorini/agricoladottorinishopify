{% comment %}
  TEMPORARY: compares the section tint colors while choosing one.
  To remove: delete this file and the `render 'tint-switcher'` line in
  sections/header.liquid.
{% endcomment %}
<button type="button" class="tint-switcher" data-tint-switcher aria-label="Cambia colore sezioni">
  <span class="tint-switcher__swatch" aria-hidden="true"></span>
  <span class="tint-switcher__label"></span>
</button>

<style>
  .tint-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding: 0 0.7rem 0 0.35rem;
    border: 1px solid var(--color-surface-strong);
    border-radius: 999px;
    background: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
    font-size: 0.75rem;
    white-space: nowrap;
    cursor: pointer;
  }

  .tint-switcher__swatch {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--color-tint);
    box-shadow: inset 0 0 0 1px rgb(30 34 29 / 0.15);
  }

  @media (max-width: 599px) {
    .tint-switcher {
      padding-right: 0.35rem;
    }

    .tint-switcher__label {
      display: none;
    }
  }
</style>

<script>
  (() => {
    const options = [
      { name: 'Sabbia', value: '#EDE4D1' },
      { name: 'Salvia', value: '#E8ECDD' },
    ];
    const key = 'dottorini-tint-preview';
    const root = document.documentElement;
    const button = document.currentScript.previousElementSibling.previousElementSibling;
    const label = button.querySelector('.tint-switcher__label');

    let index = 0;
    try {
      const saved = options.findIndex((o) => o.value === localStorage.getItem(key));
      if (saved > -1) index = saved;
    } catch (e) {}

    const apply = () => {
      const option = options[index];
      root.style.setProperty('--color-tint', option.value);
      label.textContent = option.name + ' ' + option.value;
      try {
        localStorage.setItem(key, option.value);
      } catch (e) {}
    };

    button.addEventListener('click', () => {
      index = (index + 1) % options.length;
      apply();
    });
    apply();
  })();
</script>
