{% doc %}
  Behaviour for the add to cart control on the product page.

  Renders nothing visible: it defines the <quick-add> custom element, which
  adds with fetch so the shopper stays where they are and toggles
  is-loading / is-done / is-error on itself for the page to style. Without
  JavaScript the form submits normally.

  @example
  {% render 'quick-add' %}
{% enddoc %}

{% javascript %}
  class QuickAdd extends HTMLElement {
    connectedCallback() {
      this.form = this.querySelector('form');
      this.status = this.querySelector('[data-quick-add-status]');
      if (!this.form) return;

      this.onSubmit = async (event) => {
        event.preventDefault();
        if (this.busy) return;
        this.busy = true;
        clearTimeout(this.timer);
        this.classList.remove('is-done', 'is-error');
        this.classList.add('is-loading');

        try {
          const formData = new FormData(this.form);

          // Some variants stay "available" even past their real stock
          // (continue-selling policy), and /cart/add.js happily oversells
          // them, so the stock ceiling from Liquid is enforced here rather
          // than trusting the server to refuse the request.
          if (this.dataset.inventoryQuantity !== undefined) {
            const limit = Number(this.dataset.inventoryQuantity);
            const requested = Number(formData.get('quantity')) || 1;
            const inCart = await this.quantityInCart(formData.get('id'));
            if (requested > limit - inCart) {
              this.classList.remove('is-loading');
              this.classList.add('is-error');
              if (this.status) this.status.textContent = this.dataset.stockError || this.dataset.error || '';
              this.timer = setTimeout(() => this.classList.remove('is-error'), 2500);
              return;
            }
          }

          const url = `${this.dataset.addUrl || '/cart/add'}.js`;
          const response = await fetch(url, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });

          if (!response.ok) {
            // Shopify refuses the add when the requested quantity outgrows
            // stock (422). Say so with the same message the cart drawer
            // uses, rather than a generic failure.
            this.classList.remove('is-loading');
            this.classList.add('is-error');
            const isStockError = response.status === 422;
            if (this.status) {
              this.status.textContent = (isStockError && this.dataset.stockError) || this.dataset.error || '';
            }
            this.timer = setTimeout(() => this.classList.remove('is-error'), 2500);
            return;
          }

          this.classList.remove('is-loading');
          this.classList.add('is-done');
          if (this.status) this.status.textContent = this.dataset.added || '';
          this.refreshCartCount();
          document.dispatchEvent(new CustomEvent('cart:updated'));
          this.timer = setTimeout(() => {
            this.classList.remove('is-done');
            if (this.status) this.status.textContent = '';
          }, 1800);
        } catch (error) {
          this.classList.remove('is-loading');
          this.classList.add('is-error');
          if (this.status) this.status.textContent = this.dataset.error || '';
          this.timer = setTimeout(() => this.classList.remove('is-error'), 2500);
        } finally {
          this.busy = false;
        }
      };

      this.form.addEventListener('submit', this.onSubmit);
    }

    // Sums what's already in the cart for this variant, so a second add
    // is checked against what's actually still available, not the full stock.
    async quantityInCart(variantId) {
      try {
        const response = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
        if (!response.ok) return 0;
        const cart = await response.json();
        return cart.items
          .filter((item) => String(item.variant_id) === String(variantId))
          .reduce((total, item) => total + item.quantity, 0);
      } catch (error) {
        return 0;
      }
    }

    // Keeps the header badge in step without reloading the page
    async refreshCartCount() {
      try {
        const response = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
        if (!response.ok) return;
        const cart = await response.json();
        const link = document.querySelector('.site-header__cart');
        if (!link) return;

        let badge = link.querySelector('.site-header__cart-count');
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'site-header__cart-count';
          link.appendChild(badge);
        }
        badge.textContent = cart.item_count;
        badge.classList.remove('is-bumped');
        void badge.offsetWidth;
        badge.classList.add('is-bumped');
      } catch (error) {
        /* the badge simply stays as it was */
      }
    }

    disconnectedCallback() {
      this.form?.removeEventListener('submit', this.onSubmit);
      clearTimeout(this.timer);
    }
  }

  if (!customElements.get('quick-add')) customElements.define('quick-add', QuickAdd);
{% endjavascript %}
