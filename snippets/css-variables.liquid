{% style %}
  {% comment %}
    Three self-hosted families (Google Fonts, SIL Open Font License), latin
    subset only. Hanken Grotesk and Cormorant Garamond are variable fonts, so
    one file covers every weight listed in its range.
    - Hanken Grotesk: body text and UI
    - Marcellus: headings and display lines (one weight, no italic)
    - Cormorant Garamond italic: emphasis inside headings and italic taglines
  {% endcomment %}
  @font-face {
    font-family: 'Hanken Grotesk';
    font-style: normal;
    font-weight: 400 500;
    font-display: swap;
    src: url('{{ 'hanken-grotesk.woff2' | asset_url }}') format('woff2');
  }
  @font-face {
    font-family: 'Hanken Grotesk';
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'hanken-grotesk-italic.woff2' | asset_url }}') format('woff2');
  }
  @font-face {
    font-family: 'Marcellus';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'marcellus-400.woff2' | asset_url }}') format('woff2');
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    font-style: italic;
    font-weight: 400 500;
    font-display: swap;
    src: url('{{ 'cormorant-garamond-italic.woff2' | asset_url }}') format('woff2');
  }

  :root {
    --font-body--family: 'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-heading--family: 'Marcellus', Georgia, 'Times New Roman', serif;
    --font-accent--family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-accent: {{ settings.accent_color }};
    --color-accent-base: {{ settings.accent_color }};
    --color-accent-light: {{ settings.accent_light_color }};
    --color-muted: {{ settings.muted_color }};
    --color-muted-base: {{ settings.muted_color }};
    --color-surface: {{ settings.surface_color }};
    --color-surface-base: {{ settings.surface_color }};
    --color-surface-strong: {{ settings.surface_strong_color }};
    --color-tint: {{ settings.tint_color }};
    --color-dark: {{ settings.dark_color }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
{% endstyle %}
