{% doc %}
  The header menu links, shared by the desktop bar and the phone drawer.

  The links are header section settings (nav_1 to nav_6, a label and a link
  each), not a Shopify menu, so homepage anchors like /#collina live in the
  theme. A link with a blank label is skipped.

  @param {object} settings - The header section settings
  @param {boolean} [stagger] - Add the --i index the drawer uses for its entrance

  @example
  {% render 'header-nav-links', settings: section.settings, stagger: true %}
{% enddoc %}

{%- assign index = 0 -%}

{%- for i in (1..6) -%}
  {%- liquid
    assign label_key = 'nav_' | append: i | append: '_label'
    assign href_key = 'nav_' | append: i | append: '_href'
    assign label = settings[label_key]
    assign href = settings[href_key] | default: '#'
  -%}

  {%- if label != blank -%}
    <a
      href="{{ href }}"
      {% if stagger %}
        style="--i: {{ index }}"
      {% endif %}
      {% if href == request.path %}
        aria-current="page"
      {% endif %}
    >
      {{- label | escape -}}
    </a>
    {%- assign index = index | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
